#!/usr/bin/env bash
# pleach — parallel, isolated work sessions for multi-repo workspaces
# ("pleached worktrees"). Runs N LLM/editor sessions on the same project at the
# same time without directory replicas: each session is a folder mounted with one
# git worktree PER REPO (root + nested sub-repos), all on branch session/<name>.
# Git guarantees a branch is checked out in at most one worktree at a time — two
# sessions can never step on each other.
#
# Command reference: `pleach help` and `pleach help <command>`.
# Config file reference: `pleach help config`.
# Full docs: https://github.com/guedesdiogo/pleach
# shellcheck disable=SC2015  # deliberate idiom: [ -z "$x" ] && x=… || err (err never runs after an assignment)
set -euo pipefail

PLEACH_VERSION="1.7.0"

CONF_NAME=".pleach.conf"
USER_CONF="$HOME/.config/pleach/config"
PLEACH_REPO="${PLEACH_REPO:-guedesdiogo/pleach}"

err()  { echo "pleach: error: $*" >&2; exit 1; }
info() { echo "→ $*"; }
warn() { echo "  ⚠ $*" >&2; }

in_list() { # in_list <needle> [item...]
  local needle="$1" x
  shift
  for x in "$@"; do [ "$x" = "$needle" ] && return 0; done
  return 1
}

# ---------------------------------------------------------------------------
# Canonical resolution + config loading
# ---------------------------------------------------------------------------
resolve_canonical() {
  if [ -n "${PLEACH_CANONICAL:-}" ]; then
    CANONICAL="$PLEACH_CANONICAL"
    return 0
  fi
  local d="$PWD" c
  while [ "$d" != "/" ]; do
    # .session-env BEFORE .pleach.conf, and the order is the whole point: inside a
    # session both files sit in the same directory. The conf is meant to be
    # committed — it carries PLEACH_SUBS for the team — so a copy travels into
    # every session's root worktree, and the conf `init` writes names no canonical.
    # Testing it first therefore fell through to `CANONICAL="$d"` and made the
    # session its own canonical: `ls` lost the session it stood in, `new` built a
    # nested .sessions/.sessions off the session's own worktrees, the runtime slug
    # (DB and compose names) was cut from the wrong basename, and doctor certified
    # the lot. .session-env is both the more specific answer and the one pleach
    # wrote itself, so it wins.
    if [ -f "$d/.session-env" ]; then
      c=$(grep -m1 '^export PLEACH_CANONICAL=' "$d/.session-env" 2>/dev/null | cut -d= -f2- | tr -d '"') || c=""
      [ -n "$c" ] && { CANONICAL="$c"; return 0; }
    fi
    if [ -f "$d/$CONF_NAME" ]; then
      c=$(bash -c "PLEACH_CANONICAL=''; source '$d/$CONF_NAME' 2>/dev/null; printf '%s' \"\${PLEACH_CANONICAL:-}\"") || c=""
      CANONICAL="${c:-$d}"
      return 0
    fi
    d=$(dirname "$d")
  done
  if [ -f "$USER_CONF" ]; then
    # shellcheck disable=SC1090
    source "$USER_CONF"
    if [ -n "${PLEACH_DEFAULT_CANONICAL:-}" ]; then
      CANONICAL="$PLEACH_DEFAULT_CANONICAL"
      return 0
    fi
  fi
  return 1
}

detect_subs() { # echoes the names of first-level dirs of the canonical that are git repos
  local d
  for d in "$CANONICAL"/*/; do
    [ -e "${d%/}/.git" ] && basename "${d%/}"
  done
  # Without this, a trailing non-repo dir (docs/, scripts/…) leaves status 1 and,
  # under `set -e` + pipefail, kills any caller capturing the output with $( … ).
  return 0
}

load_config() {
  resolve_canonical || err "cannot tell which workspace is canonical. Options:
  - run inside a project that has a $CONF_NAME (create one with: pleach init)
  - set PLEACH_CANONICAL=/path
  - record a machine-wide default: echo 'PLEACH_DEFAULT_CANONICAL=/path' >> $USER_CONF"
  CANONICAL="${CANONICAL%/}"
  # Guard rail for harnesses/automation: if the caller declares the canonical it
  # EXPECTS, any divergent resolution aborts before touching real worktrees.
  if [ -n "${PLEACH_EXPECT_CANONICAL:-}" ] && [ "$CANONICAL" != "${PLEACH_EXPECT_CANONICAL%/}" ]; then
    err "resolved canonical ($CANONICAL) differs from the expected one (PLEACH_EXPECT_CANONICAL=${PLEACH_EXPECT_CANONICAL%/}) — aborted before any write"
  fi
  [ -e "$CANONICAL/.git" ] || err "canonical '$CANONICAL' is not a git repo"

  SUBS=()
  CONF_DECLARES_SUBS=0
  SECRETS_EXTRA=(".claude/settings.local.json")
  if [ -f "$CANONICAL/$CONF_NAME" ]; then
    # shellcheck disable=SC1090
    source "$CANONICAL/$CONF_NAME"
    [ -n "${PLEACH_SUBS+x}" ] && { SUBS=(${PLEACH_SUBS[@]+"${PLEACH_SUBS[@]}"}); CONF_DECLARES_SUBS=1; }
    [ -n "${PLEACH_SECRETS_EXTRA+x}" ] && SECRETS_EXTRA+=(${PLEACH_SECRETS_EXTRA[@]+"${PLEACH_SECRETS_EXTRA[@]}"})
  fi
  BASE="${PLEACH_BASE:-main}"
  PORT_START="${PLEACH_PORT_START:-10000}"
  SESSIONS="${PLEACH_DIR:-$(dirname "$CANONICAL")/.sessions}"
  if [ ${#SUBS[@]} -eq 0 ]; then
    local s
    while IFS= read -r s; do [ -n "$s" ] && SUBS+=("$s"); done < <(detect_subs)
  fi
}

# ---------------------------------------------------------------------------
# Simple lock (mkdir is atomic; flock is absent from a base macOS) — serializes
# worktree creation/removal across concurrent invocations.
# ---------------------------------------------------------------------------
LOCK_PATH=""
LOCK_OWNER=""   # "<pid> <host>" — the contents of the lock file
LOCK_SCRATCH="" # where that line is composed before it is linked into place
TMPFILE=""   # see cmd_conflicts: an EXIT trap outlives any local it might reference
lock_try() { # 0 = we now hold the lock
  # A directory lock is what versions before this one used, and `ln A somedir` does
  # not fail — it creates somedir/A. Wait such a lock out rather than link into it.
  if [ -d "$LOCK_PATH" ]; then
    return 1
  fi
  # The owner line is written to a scratch file FIRST and hard-linked into place,
  # so the lock is complete at the instant it begins to exist: there is no moment
  # at which a held lock names nobody. Both paths live under $SESSIONS, so the link
  # cannot fail across filesystems. (A symlink whose target carried the owner would
  # be atomic too, but Git Bash does not give us real symlinks.)
  printf '%s\n' "$LOCK_OWNER" > "$LOCK_SCRATCH" 2>/dev/null || return 1
  if ln "$LOCK_SCRATCH" "$LOCK_PATH" 2>/dev/null && [ -f "$LOCK_PATH" ]; then
    rm -f "$LOCK_SCRATCH" 2>/dev/null || true
    return 0
  fi
  # Either someone else holds it, or a legacy directory appeared between the check
  # above and the link, in which case we have just linked INTO it. Undo both.
  rm -f "$LOCK_PATH/$(basename "$LOCK_SCRATCH")" 2>/dev/null || true
  rm -f "$LOCK_SCRATCH" 2>/dev/null || true
  return 1
}
lock() {
  LOCK_PATH="$SESSIONS/.pleach.lock"
  LOCK_SCRATCH="$SESSIONS/.pleach.lock.$$"
  # Who owns the lock has to be recorded BY the act of taking it, not after it.
  # It used to be two steps — mkdir, then write an `owner` file — with a fork for
  # `uname` sitting between them. A run killed inside that window left a lock with
  # no owner, and an owner-less lock is the one shape doctor must refuse to clear
  # (it cannot be told apart from a live run's), so --fix declined and the whole
  # workspace stayed wedged behind a manual rmdir.
  local host tries=0
  host=$(uname -n 2>/dev/null || echo '?')   # forked BEFORE the loop, never inside it
  LOCK_OWNER="$$ $host"
  until lock_try; do
    tries=$((tries + 1))
    [ "$tries" -gt 120 ] && err "could not acquire the lock at $LOCK_PATH (an earlier creation wedged? inspect and release it with: pleach doctor --fix)"
    sleep 1
  done
  trap 'unlock' EXIT
}
unlock() {
  if [ -n "$LOCK_PATH" ]; then
    if [ -d "$LOCK_PATH" ]; then
      rm -f "$LOCK_PATH/owner" 2>/dev/null || true   # a directory lock from an older version
      rmdir "$LOCK_PATH" 2>/dev/null || true
    else
      rm -f "$LOCK_PATH" 2>/dev/null || true
    fi
  fi
  # Killed between composing the scratch line and linking it, a run leaves that one
  # file behind. It is inert — `ls` walks directories, and nothing reads it — so
  # doctor does not chase it; the trap covers every exit that runs code at all.
  [ -n "$LOCK_SCRATCH" ] && rm -f "$LOCK_SCRATCH" 2>/dev/null || true
  LOCK_PATH=""
  trap - EXIT
}

session_branch() { echo "session/$1"; }

sanitize_ident() { # -> [a-z0-9_] — safe as a Postgres identifier or a compose project name
  # Injective over the SESSION-NAME alphabet, which is the collision that bites:
  # names are validated as [a-z0-9_-], and if '-' and '_' collapsed onto the same
  # character then 'fix-login' and 'fix_login' would share a database — exactly
  # what this identity exists to prevent. Doubling the underscores already present
  # keeps them apart: 'fix-login' -> fix_login, 'fix_login' -> fix__login.
  #
  # It is NOT injective over arbitrary text, and the canonical's directory name is
  # arbitrary: 'acme-app' and 'acme.app' both become acme_app, as do 'Acme' and
  # 'acme'. Two workspaces whose directory names differ only in punctuation or
  # case would therefore share a slug. Closing that would mean hex-escaping every
  # separator, and a database called acme_2dapp__fix_2dlogin is a worse daily cost
  # than a collision nobody has hit. The limit is documented rather than hidden.
  local s="$1"
  s="${s//_/__}"
  s="${s//[^a-zA-Z0-9_]/_}"
  printf '%s' "$s" | tr '[:upper:]' '[:lower:]'
}

session_slug() { # $1 name — the session's runtime identity, unique per workspace
  # Prefixed with the canonical's directory name so two projects that both have a
  # session called "fix-login" do not end up sharing a database or a compose project.
  sanitize_ident "$(basename "$CANONICAL")_$1"
}

normalize_path() { # git on Windows reports C:/Users/… while the shell uses /c/Users/…
  case "$1" in
    [A-Za-z]:/*) printf '/%s%s' "$(printf '%s' "${1%%:*}" | tr '[:upper:]' '[:lower:]')" "${1#*:}" ;;
    *)           printf '%s' "$1" ;;
  esac
}

session_listeners() { # $1 port_base — echoes "<pid>\t<command>" per process listening in the block
  # Worktrees isolate files, not sockets: a dev server started in a session keeps
  # its port after the session is gone. With no way to ask, we say nothing — never
  # a false "nothing is listening".
  local pb="${1:-}" top
  [ -n "$pb" ] || return 0
  top=$((pb + 99))
  if command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP:"$pb"-"$top" -sTCP:LISTEN -F pc 2>/dev/null | awk '
      /^p/ { pid = substr($0, 2) }
      /^c/ { print pid "\t" substr($0, 2) }
    ' | sort -u
  elif command -v ss >/dev/null 2>&1; then
    # Linux: `netstat -ano` is NOT the right tool here — on Linux -o means timers,
    # not pids, so the last column would be "off (0.00/0/0)". Filtered through
    # /^[0-9]+$/ that yields an empty list: precisely the false "nothing is
    # listening" this function exists to avoid. ss reports the owner:
    # users:(("node",pid=1234,fd=20)).
    ss -lntp 2>/dev/null | awk -v lo="$pb" -v hi="$top" '
      /LISTEN/ {
        n = split($4, parts, ":")
        port = parts[n] + 0
        if (port < lo || port > hi) next
        if (match($0, /pid=[0-9]+/)) {
          pid = substr($0, RSTART + 4, RLENGTH - 4)
          cmd = "?"
          if (match($0, /\(\("[^"]+"/)) cmd = substr($0, RSTART + 3, RLENGTH - 4)
          print pid "\t" cmd
        }
      }
    ' | sort -u
  elif command -v netstat >/dev/null 2>&1; then
    case "$(uname -s 2>/dev/null)" in
      MINGW*|MSYS*|CYGWIN*)
        # Windows (Git Bash): netstat -ano gives "…:<port> … LISTENING <pid>".
        netstat -ano 2>/dev/null | awk -v lo="$pb" -v hi="$top" '
          /LISTENING/ {
            n = split($2, parts, ":")
            port = parts[n] + 0
            if (port >= lo && port <= hi && $NF ~ /^[0-9]+$/) print $NF "\t?"
          }
        ' | sort -u
        ;;
    esac
  fi
  return 0
}

write_session_env() { # $1 dir, $2 name, $3 index, $4 port_base, [$5 base ref]
  # Per-session ports (next dev and friends honour PORT) plus a runtime identity.
  # The identity matters as much as the ports: two sessions migrating the same
  # database collide in state, and git cannot see that kind of collision.
  #
  # base_ref goes through %q rather than double quotes: this file is read with
  # `source`, and git ACCEPTS branch names like 'feat/$(whoami)' — inside quotes,
  # such a name would execute on the next `pleach open`. For ordinary values %q
  # changes nothing (s4 -> s4), so session_env_get still reads them as before.
  local dir="$1" name="$2" idx="$3" pb="$4" base_ref="${5:-$BASE}" slug
  slug=$(session_slug "$name")
  cat > "$dir/.session-env" <<EOF
# Generated by pleach — 'source .session-env' before starting dev servers.
# This session's exclusive port block: ${pb}-$((pb + 99)).
export PLEACH_NAME=$name
export PLEACH_CANONICAL="$CANONICAL"
export PLEACH_INDEX=$idx
export PLEACH_BASE_REF=$(printf '%q' "$base_ref")
export PLEACH_PORT_BASE=$pb
export PORT=$pb
export WRANGLER_PORT=$((pb + 87))
export WRANGLER_INSPECTOR_PORT=$((pb + 29))
export PLAYWRIGHT_PORT=$((pb + 90))
# Runtime identity — for the state git does not isolate (databases, containers).
export PLEACH_SLUG=$slug
export PLEACH_DB_NAME=$slug
export COMPOSE_PROJECT_NAME=$slug
EOF
  # One PORT is not enough for a workspace with more than one service. They all read
  # $PORT, so the second one to start dies on EADDRINUSE — INSIDE a single session,
  # which is the collision this tool exists to remove. The block is 100 wide; each
  # mounted repo gets its own slot off the base, deterministic and stable across
  # runs. WRANGLER_INSPECTOR_PORT sits at +29, so this stays below it.
  local i=1 sub var
  while IFS= read -r sub; do
    [ -n "$sub" ] || continue
    [ "$i" -ge 29 ] && { warn "more than 28 sub-repos — ports beyond +28 are not allocated"; break; }
    # Existing underscores are doubled BEFORE other punctuation becomes one, or
    # 'api-web' and 'api_web' would both land on PLEACH_PORT_API_WEB — the second
    # export silently winning and putting two services back on one port, which is
    # the exact bug this loop exists to fix. Same trick as session_slug.
    var=$(printf '%s' "$sub" | sed 's/_/__/g' | tr '[:lower:]' '[:upper:]' | tr -c 'A-Z0-9' '_')
    printf 'export PLEACH_PORT_%s=%s\n' "$var" "$((pb + i))" >> "$dir/.session-env"
    i=$((i + 1))
  done < <(session_subs "$dir")
}

backfill_session_env() { # $1 dir, $2 name — adds variables introduced after this session was created
  local dir="$1" name="$2" slug
  [ -f "$dir/.session-env" ] || return 0
  grep -q '^export PLEACH_SLUG=' "$dir/.session-env" && return 0
  slug=$(session_slug "$name")
  cat >> "$dir/.session-env" <<EOF
# Added by a later pleach version — runtime identity for non-file state.
export PLEACH_SLUG=$slug
export PLEACH_DB_NAME=$slug
export COMPOSE_PROJECT_NAME=$slug
EOF
}

json_escape() { # escapes \ and " for embedding in JSON
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

write_panorama_workspace() {
  # Generates $SESSIONS/panorama.code-workspace (once; it is static): ONE VS Code
  # window with ALL sessions — scanMaxDepth 2 lets Source Control discover each
  # session's repos (root at one level, subs at two).
  [ -f "$SESSIONS/panorama.code-workspace" ] && return 0
  cat > "$SESSIONS/panorama.code-workspace" <<'EOF'
{
  "folders": [{ "path": "." }],
  "settings": {
    "git.repositoryScanMaxDepth": 2,
    "scm.repositories.sortOrder": "path",
    "scm.repositories.visible": 20
  }
}
EOF
}

write_vscode_workspace() { # $1 name, $2 session dir, rest = subs
  # Generates <dir>.code-workspace (outside the worktrees — keeps git status
  # clean): multi-root with the root + each sub, so VS Code's Source Control
  # shows every repo in the session.
  local name="$1" dir="$2" s folders
  shift 2
  folders="    { \"path\": \"$(json_escape "$name")\" }"
  for s in "$@"; do
    folders="$folders,
    { \"path\": \"$(json_escape "$name/$s")\" }"
  done
  cat > "$dir.code-workspace" <<EOF
{
  "folders": [
$folders
  ]
}
EOF
}

refresh_vscode_workspace() { # $1 name, $2 dir — regenerates with the subs present
  local -a present=()
  local s
  while IFS= read -r s; do [ -n "$s" ] && present+=("$s"); done < <(session_subs "$2")
  write_vscode_workspace "$1" "$2" ${present[@]+"${present[@]}"}
}

session_subs() { # subs present in an existing session
  local dir="$1" d
  for d in "$dir"/*/; do
    [ -e "${d%/}/.git" ] && basename "${d%/}"
  done
  return 0   # see the note in detect_subs
}

session_names() { # names of the existing sessions
  local d
  for d in "$SESSIONS"/*/; do
    [ -d "$d" ] && [ -e "${d%/}/.git" ] && basename "${d%/}"
  done
  return 0   # see the note in detect_subs
}

session_env_get() { # $1 dir, $2 key
  grep -m1 "^export $2=" "$1/.session-env" 2>/dev/null | cut -d= -f2- | tr -d '"' || true
}

detect_session_name() { # echoes the name of the session containing $PWD (if any)
  local d="$PWD" n
  while [ "$d" != "/" ]; do
    if [ -f "$d/.session-env" ]; then
      n=$(session_env_get "$d" PLEACH_NAME)
      [ -n "$n" ] && { printf '%s' "$n"; return 0; }
    fi
    d=$(dirname "$d")
  done
  return 1
}

repo_path() { # $1 = "" (root) or a sub name
  if [ -z "$1" ]; then echo "$CANONICAL"; else echo "$CANONICAL/$1"; fi
}

free_index() { # lowest index no session's .session-env claims -> its port block
  refuse_unreadable_sessions
  local idx=1 used d
  while :; do
    used=0
    for d in "$SESSIONS"/*/.session-env; do
      [ -f "$d" ] || continue
      grep -q "^export PLEACH_INDEX=$idx\$" "$d" && { used=1; break; }
    done
    [ "$used" -eq 0 ] && break
    idx=$((idx + 1))
    [ "$idx" -gt 98 ] && err "no free index left (98 sessions?!)"
  done
  printf '%s' "$idx"
}

session_env_unreadable() { # $1 dir — a .session-env is there, but not one pleach reads
  # Readable means exactly one PLEACH_INDEX declaration carrying a number. The near
  # misses are not pedantry: an empty value satisfies "the line is there" and then
  # reports as a blank — the "index , ports +" tick this guard exists to stop — and
  # two declarations disagree by construction, because pleach reads the first while
  # `source .session-env` exports the last, so the block reported and the block
  # actually bound are different numbers.
  [ -f "$1/.session-env" ] || return 1
  local lines idx
  lines=$(grep -c '^export PLEACH_INDEX=' "$1/.session-env" || true)
  [ "$lines" = "1" ] || return 0
  idx=$(grep -m1 '^export PLEACH_INDEX=' "$1/.session-env" | cut -d= -f2-)
  case "$idx" in
    ''|*[!0-9]*) return 0 ;;
  esac
  return 1
}

unreadable_sessions() { # names of the sessions whose .session-env cannot be read
  local d
  for d in "$SESSIONS"/*/; do
    [ -d "$d" ] || continue
    if session_env_unreadable "${d%/}"; then basename "${d%/}"; fi
  done
}

refuse_unreadable_sessions() { # every port-block allocation goes through here
  # "I could not read it" is not "there is nothing there". A session directory
  # holding a .session-env with no PLEACH_INDEX is serving a block of ports that
  # cannot be named, so no other index can be certified free either. Allocating
  # anyway is how a workspace ends up with two sessions on one block, and the
  # symptom — a second dev server dying on EADDRINUSE, or worse, a browser
  # talking to the other session's server — does not point back here. This was
  # measured, not imagined: adopting pleach over sessions another tool had
  # created handed the new one the exact block a live session was serving on,
  # and `doctor` closed the same run with "no problems found".
  local names first
  names=$(unreadable_sessions) || true
  [ -n "$names" ] || return 0
  first=$(printf '%s\n' "$names" | head -1)
  # The list goes last on purpose: spliced mid-sentence it came out as "alphahas
  # a .session-env", because a one-name list has no trailing separator to join on.
  err "cannot allocate a port block — a session is holding one that cannot be named (its .session-env has no PLEACH_INDEX). Convert it or remove it: rm '$SESSIONS/$first/.session-env'. Affected: $(printf '%s' "$names" | tr '\n' ' ')"
}

session_incomplete() { # 0 when a creation started for $1 and never finished
  [ -e "$SESSIONS/.pleach-building.$1" ]
}

warn_if_behind() { # $1 repo, $2 label
  local behind
  behind=$(git -C "$1" rev-list --count "$BASE..origin/$BASE" 2>/dev/null || echo 0)
  if [ "${behind:-0}" -gt 0 ]; then
    warn "$2: local $BASE is $behind commit(s) behind origin/$BASE (create with --fetch to update)"
  fi
}

# ---------------------------------------------------------------------------
# Blocks shared by new/add/repos
# ---------------------------------------------------------------------------
add_wt() { # $1 repo, $2 target, $3 branch, [$4 base ref] — new or resumed worktree
  local from="${4:-$BASE}" fallback
  if git -C "$1" show-ref --verify --quiet "refs/heads/$3"; then
    info "resuming existing branch $3 in $(basename "$1")"
    git -C "$1" worktree add --quiet "$2" "$3"
    return
  fi
  # A repo that does not carry the workspace base is not a broken repo — plenty of
  # older ones are still on master, and PLEACH_BASE is one value for the whole
  # workspace, so no setting satisfies both. Cutting from THIS repo's own current
  # branch turns an adoption blocker into a line of output. Before this, a single
  # legacy repo meant no session could be created at all, and the error was git's
  # raw "fatal: invalid reference: main", naming neither the repo nor PLEACH_BASE.
  if ! git -C "$1" rev-parse --verify --quiet "$from^{commit}" >/dev/null 2>&1; then
    fallback=$(git -C "$1" symbolic-ref --quiet --short HEAD 2>/dev/null || echo "")
    [ -n "$fallback" ] || err "$(basename "$1"): has neither '$from' nor a checked-out branch to cut from"
    warn "$(basename "$1"): no '$from' here — cutting from '$fallback' instead"
    from="$fallback"
  fi
  git -C "$1" worktree add --quiet -b "$3" "$2" "$from"
}

resolve_from_ref() { # $1 repo, $2 requested, $3 label — echoes the ref to cut from
  # A session name resolves to that session's branch; anything else is taken as a
  # plain git ref. A repo where the requested ref does not exist falls back to the
  # base and says so: in a multi-repo tool, one repo must never block the others.
  local repo="$1" want="$2" label="$3" candidate
  if [ -d "$SESSIONS/$want" ]; then candidate=$(session_branch "$want"); else candidate="$want"; fi
  if git -C "$repo" rev-parse --verify --quiet "$candidate^{commit}" >/dev/null 2>&1; then
    printf '%s' "$candidate"
  else
    warn "$label: '$candidate' does not exist here — cutting from $BASE instead"
    printf '%s' "$BASE"
  fi
}

copy_secrets() { # $1 session dir, $2 include root (0|1), rest: target subs
  # Untracked secrets/env: copy from the canonical, preserving paths. Files
  # inside a sub-repo are only included if that sub is part of the target.
  local dir="$1" include_root="$2"
  shift 2
  local copied=0 f top
  while IFS= read -r -d '' f; do
    f="${f#./}"
    top="${f%%/*}"
    if [ "$top" != "$f" ] && [ -e "$CANONICAL/$top/.git" ]; then
      in_list "$top" "$@" || continue
    else
      [ "$include_root" -eq 1 ] || continue
    fi
    mkdir -p "$dir/$(dirname "$f")"
    cp "$CANONICAL/$f" "$dir/$f"
    copied=$((copied + 1))
  done < <(cd "$CANONICAL" && find . -maxdepth 4 \
      \( -name node_modules -o -name .git -o -name .next -o -name .open-next \
         -o -name .wrangler -o -name dist -o -name build -o -name target \
         -o -name .venv -o -name vendor \) -prune -o \
      -type f \( -name '.env' -o -name '.env.*' -o -name '.dev.vars' -o -name '.dev.vars.*' \) \
      ! -name '*.example' -print0)
  for f in ${SECRETS_EXTRA[@]+"${SECRETS_EXTRA[@]}"}; do
    top="${f%%/*}"
    if [ "$top" != "$f" ] && [ -e "$CANONICAL/$top/.git" ]; then
      in_list "$top" "$@" || continue
    else
      [ "$include_root" -eq 1 ] || continue
    fi
    if [ -f "$CANONICAL/$f" ]; then
      mkdir -p "$dir/$(dirname "$f")"
      cp "$CANONICAL/$f" "$dir/$f"
      copied=$((copied + 1))
    fi
  done
  info "$copied env file(s) copied"
}

run_bootstrap() { # $1 session dir, $2 sub ("" = whole session)
  local dir="$1" sub="${2:-}" target depth
  if [ -n "$sub" ]; then target="$dir/$sub"; depth=2; else target="$dir"; depth=3; fi
  if [ -f "$CANONICAL/$CONF_NAME" ] && bash -c "source '$CANONICAL/$CONF_NAME' 2>/dev/null; declare -f pleach_bootstrap >/dev/null"; then
    info "project bootstrap (pleach_bootstrap from $CONF_NAME)…"
    ( cd "$dir" && bash -c "source '$CANONICAL/$CONF_NAME'; pleach_bootstrap '$dir' '$sub'" ) \
      || warn "pleach_bootstrap returned an error — check by hand"
  elif command -v bun >/dev/null 2>&1; then
    info "default bootstrap: bun install wherever there is a package.json (4-way parallel)…"
    # sh -c '…' _ <path>: the path arrives as "$1". Avoids `xargs -I{}`, whose
    # substitution is capped at 255 bytes in BSD xargs (macOS) and blows up with
    # "command line cannot be assembled" on long paths.
    # shellcheck disable=SC2016  # single quotes deliberate: $1 expands in the child sh
    find "$target" -maxdepth "$depth" -name package.json -not -path '*/node_modules/*' -print0 \
      | xargs -0 -n1 -P 4 sh -c 'd=$(dirname "$1"); cd "$d" && bun install --silent >/dev/null 2>&1 || echo "  ⚠ bun install failed in $d"' _ \
      || warn "there were bootstrap failures — check by hand"
  else
    info "no bootstrap (define pleach_bootstrap in $CONF_NAME if the project needs one)"
  fi
}

mount_sub() { # $1 session name, $2 dir, $3 sub, $4 bootstrap (0|1)
  # The lock belongs to the CALLER (taken once around the batch): taking it here,
  # per iteration, would orphan the lock if an add_wt failed mid-loop.
  local name="$1" dir="$2" s="$3" bs="$4" branch
  branch=$(session_branch "$name")
  [ -e "$CANONICAL/$s/.git" ] || { warn "$name: sub-repo '$s' does not exist at $CANONICAL/$s — skipped"; return 1; }
  if [ -e "$dir/$s/.git" ]; then
    info "$name: '$s' is already mounted"
    return 0
  fi
  warn_if_behind "$CANONICAL/$s" "$s"
  add_wt "$CANONICAL/$s" "$dir/$s" "$branch"
  copy_secrets "$dir" 0 "$s"
  [ "$bs" -eq 1 ] && run_bootstrap "$dir" "$s"
  refresh_vscode_workspace "$name" "$dir"
  info "$name: '$s' mounted (branch $branch)"
}

# ---------------------------------------------------------------------------
cmd_init() {
  local defaultize=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --default) defaultize=1 ;;
      *) err "unknown flag: $1 (usage: pleach init [--default])" ;;
    esac
    shift
  done
  [ -e "$PWD/.git" ] || err "run this at the root of the workspace's canonical repo (no .git found in $PWD)"
  [ -f "$PWD/$CONF_NAME" ] && err "$CONF_NAME already exists here"
  CANONICAL="$PWD"
  local -a detected=()
  local subs_line="" s
  while IFS= read -r s; do
    [ -n "$s" ] && detected+=("$s") && subs_line="$subs_line $(printf '%q' "$s")"
  done < <(detect_subs)
  if [ ${#detected[@]} -gt 0 ]; then
    subs_line="PLEACH_SUBS=(${subs_line# })"
  else
    subs_line="# PLEACH_SUBS=()   # no sub-repos detected — single-repo project, works all the same"
  fi
  cat > "$PWD/$CONF_NAME" <<EOF
# pleach — project config (bash, sourced). Docs: pleach help config.
# This file at the root marks the workspace; in replicas/mirrors, point at the
# real canonical with PLEACH_CANONICAL=/path.

# Sub-repos to mount per session (default: auto-detect first-level dirs with .git).
# When a new repo joins the workspace: pleach repos --sync
$subs_line

# PLEACH_BASE=main
# PLEACH_DIR=$(dirname "$PWD")/.sessions
# PLEACH_PORT_START=10000
# PLEACH_SECRETS_EXTRA=()

# Post-creation bootstrap (\$1 = session folder, \$2 = sub being mounted, or empty
# for the whole session). Default: bun install wherever there is a package.json.
# pleach_bootstrap() {
#   (cd app && npm install)
# }
EOF
  info "created $PWD/$CONF_NAME (subs detected: ${detected[*]:-none})"
  if [ "$defaultize" -eq 1 ]; then
    mkdir -p "$(dirname "$USER_CONF")"
    if [ -f "$USER_CONF" ] && grep -q '^PLEACH_DEFAULT_CANONICAL=' "$USER_CONF"; then
      local tmp
      tmp=$(mktemp)
      grep -v '^PLEACH_DEFAULT_CANONICAL=' "$USER_CONF" > "$tmp" || true
      mv "$tmp" "$USER_CONF"
    fi
    echo "PLEACH_DEFAULT_CANONICAL=\"$PWD\"" >> "$USER_CONF"
    info "recorded as this machine's default project in $USER_CONF"
  fi
  echo "Next: review the $CONF_NAME, then 'pleach new <name>' or 'pleach open <name>'."
  echo "      and teach your agents about it: pleach skill --project"
}

# ---------------------------------------------------------------------------
cmd_new() {
  local name="" do_bootstrap=1 do_fetch=0 from=""
  local -a subs=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-bootstrap|--no-install) do_bootstrap=0 ;;
      --fetch)      do_fetch=1 ;;
      --from)       from="${2:-}"; [ -n "$from" ] || err "--from needs a session name or a git ref"; shift ;;
      -*)           err "unknown flag: $1" ;;
      *)            if [ -z "$name" ]; then name="$1"; else subs+=("$1"); fi ;;
    esac
    shift
  done
  [ -n "$name" ] || err "usage: pleach new <name> [sub ...] [--from <session|ref>] [--no-bootstrap] [--fetch]"
  [[ "$name" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || err "invalid name '$name' (use [a-z0-9_-], starting with a letter or digit)"
  load_config
  [ ${#subs[@]} -eq 0 ] && subs=(${SUBS[@]+"${SUBS[@]}"})
  local s
  for s in ${subs[@]+"${subs[@]}"}; do
    [ -e "$CANONICAL/$s/.git" ] || err "sub-repo '$s' not found at $CANONICAL/$s"
  done

  local dir="$SESSIONS/$name" branch
  branch=$(session_branch "$name")
  [ -e "$dir" ] && err "session '$name' already exists at $dir"

  # Before a single byte is written: refusing here leaves no half-made session,
  # which is the difference between a message and a mess to clean up.
  refuse_unreadable_sessions

  mkdir -p "$SESSIONS"
  touch "$SESSIONS/.metadata_never_index" # macOS: keep Spotlight out of sessions

  if [ "$do_fetch" -eq 1 ]; then
    info "fetching origin/$BASE in every repo…"
    local repo
    for repo in "$CANONICAL" ${subs[@]+"${subs[@]/#/$CANONICAL/}"}; do
      # Fast-forward the local ref without touching the working tree; if $BASE is
      # checked out in that repo, fall back to a plain fetch (updates origin/$BASE).
      git -C "$repo" fetch --quiet origin "$BASE:$BASE" 2>/dev/null \
        || git -C "$repo" fetch --quiet origin "$BASE" \
        || warn "fetch failed in $repo (offline?) — using the local $BASE"
    done
  fi

  lock

  # Session index → a deterministic, collision-free block of 100 ports.
  local idx port_base
  idx=$(free_index)
  port_base=$((PORT_START + idx * 100))

  # From here on the session exists on disk but is not yet usable. The marker sits
  # BESIDE it, because everything inside is a worktree and a file there would show
  # up in `git status` on the branch. Only the success path at the bottom removes
  # it: a run that is killed, or that fails partway, leaves it as the evidence that
  # this session was never finished — which nothing else records once .session-env
  # exists, since from that point a half-built session has every artefact a
  # finished one has.
  local marker="$SESSIONS/.pleach-building.$name"
  : > "$marker"

  info "creating session '$name' (index $idx, ports ${port_base}-$((port_base + 99))) at $dir"
  # A block freed by `rm` is handed out again immediately, and a dev server that
  # outlived its worktree is still holding it. Silently issuing an occupied block
  # means the next session's app answers on the previous one's port — worse than
  # the crash, because it looks like it worked.
  local squatters
  squatters=$(session_listeners "$port_base")
  if [ -n "$squatters" ]; then
    warn "block ${port_base}-$((port_base + 99)) already has $(printf '%s\n' "$squatters" | wc -l | tr -d ' ') listener(s) — a previous session's processes outlived it:"
    printf '%s\n' "$squatters" | sed 's/^/      /' >&2
    warn "kill them before starting anything here, or this session will answer on their ports"
  fi
  [ -n "$from" ] && info "cutting from '$from' instead of $BASE"
  # from_used separates "I asked for --from x" from "I actually cut from x". If no
  # repo had the ref and every one fell back to the base, recording 'x' as the
  # lineage would be a lie — `ls -l` and `ls --json` would claim the session came
  # from somewhere it never did.
  local from_ref from_used=0
  if [ -n "$from" ]; then
    from_ref=$(resolve_from_ref "$CANONICAL" "$from" "root")
    [ "$from_ref" = "$BASE" ] || from_used=1
    add_wt "$CANONICAL" "$dir" "$branch" "$from_ref"
  else
    warn_if_behind "$CANONICAL" "root"
    add_wt "$CANONICAL" "$dir" "$branch"
  fi
  for s in ${subs[@]+"${subs[@]}"}; do
    if [ -n "$from" ]; then
      from_ref=$(resolve_from_ref "$CANONICAL/$s" "$from" "$s")
      [ "$from_ref" = "$BASE" ] || from_used=1
      add_wt "$CANONICAL/$s" "$dir/$s" "$branch" "$from_ref"
    else
      warn_if_behind "$CANONICAL/$s" "$s"
      add_wt "$CANONICAL/$s" "$dir/$s" "$branch"
    fi
  done

  info "copying secrets (.env*, .dev.vars*, extras from the conf)…"
  copy_secrets "$dir" 1 ${subs[@]+"${subs[@]}"}

  local recorded_ref="$BASE"
  if [ -n "$from" ] && [ "$from_used" -eq 1 ]; then recorded_ref="$from"; fi
  write_session_env "$dir" "$name" "$idx" "$port_base" "$recorded_ref"
  # The lock is held until the index is RECORDED, not merely chosen. free_index
  # reads .session-env files, so releasing between the choice and the write left a
  # window — the width of copy_secrets — in which a second `new` saw no claim on
  # this index and picked it too: two sessions on one port block, which is the
  # collision the index exists to prevent. Bootstrap stays outside; it is the slow
  # part and it reserves nothing.
  unlock
  # .session-env lives INSIDE the root worktree, so `git add -A` at the session root
  # would commit this machine's port block, DB name and absolute canonical path onto
  # the branch — and from there into main, where every session's copy then conflicts
  # with every other. info/exclude is local-only and never committed, so this costs
  # the repo nothing.
  local excl
  excl=$(git -C "$dir" rev-parse --git-path info/exclude 2>/dev/null || true)
  if [ -n "$excl" ] && ! grep -qxF '.session-env' "$excl" 2>/dev/null; then
    mkdir -p "$(dirname "$excl")" 2>/dev/null || true
    printf '.session-env\n' >> "$excl" 2>/dev/null || true
  fi

  write_vscode_workspace "$name" "$dir" ${subs[@]+"${subs[@]}"}
  write_panorama_workspace

  if [ "$do_bootstrap" -eq 1 ]; then
    run_bootstrap "$dir" ""
  else
    info "bootstrap skipped (--no-bootstrap)"
  fi

  # Everything the session needs is in place; only now is it not "being built".
  rm -f "$marker" 2>/dev/null || true

  echo ""
  echo "✅ Session '$name' ready:"
  echo "   cd $dir"
  echo "   branch $branch in: root ${subs[*]+${subs[*]}}"
  echo "   ports: source .session-env  (PORT=$port_base, one PLEACH_PORT_<SUB> per repo, DB/compose: $(session_slug "$name"))"
  echo "   VS Code: pleach open $name code  (or: code '$dir.code-workspace')"
  echo "   ⚠ deploys/shared state: from the canonical only — never from here."
}

# ---------------------------------------------------------------------------
cmd_open() {
  local name="${1:-}"
  [ -n "$name" ] || err "usage: pleach open <name> [command ...] (default: claude)"
  shift
  load_config
  local dir="$SESSIONS/$name"
  if [ ! -d "$dir" ]; then
    info "session '$name' does not exist — creating it with every sub-repo…"
    cmd_new "$name"
  fi
  cd "$dir"
  # Backfill: sessions created by older versions lack the newer artefacts.
  [ -f "$dir.code-workspace" ] || refresh_vscode_workspace "$name" "$dir"
  backfill_session_env "$dir" "$name"
  write_panorama_workspace
  # Export the session's ports/identity to the process we are about to launch.
  # shellcheck disable=SC1091
  [ -f .session-env ] && . ./.session-env
  [ $# -eq 0 ] && set -- claude
  # 'pleach open x code' → VS Code on the session's multi-root workspace (SCM for
  # every repo); with extra args, the literal command is honoured.
  [ "$1" = "code" ] && [ $# -eq 1 ] && set -- code "$dir.code-workspace"
  info "opening in $dir: $*"
  exec "$@"
}

# ---------------------------------------------------------------------------
cmd_add() {
  local do_bootstrap=1 all=0
  local -a args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --all)                    all=1 ;;
      --no-bootstrap|--no-install) do_bootstrap=0 ;;
      -*)                       err "unknown flag: $1 (usage: pleach add [<session>] <sub ...|--all>)" ;;
      *)                        args+=("$1") ;;
    esac
    shift
  done
  load_config

  # Session: the first argument if it names an existing session; otherwise the
  # session containing the cwd (handy for 'pleach add payments' from inside it).
  local name="" i
  local -a want=()
  if [ ${#args[@]} -gt 0 ] && [ -d "$SESSIONS/${args[0]}" ]; then
    name="${args[0]}"
    for ((i = 1; i < ${#args[@]}; i++)); do want+=("${args[$i]}"); done
  elif name=$(detect_session_name 2>/dev/null); then
    want=(${args[@]+"${args[@]}"})
  else
    err "cannot tell which session to add to. Usage: pleach add <session> <sub ...>
  (inside a session the name is inferred: pleach add <sub ...>)"
  fi

  local dir="$SESSIONS/$name"
  [ -d "$dir" ] || err "session '$name' does not exist at $dir"

  local -a present=()
  local s
  while IFS= read -r s; do [ -n "$s" ] && present+=("$s"); done < <(session_subs "$dir")

  if [ "$all" -eq 1 ]; then
    want=()
    for s in ${SUBS[@]+"${SUBS[@]}"}; do
      in_list "$s" ${present[@]+"${present[@]}"} || want+=("$s")
    done
    [ ${#want[@]} -eq 0 ] && { info "session '$name' already has every sub-repo in the workspace"; return 0; }
  fi
  [ ${#want[@]} -gt 0 ] || err "usage: pleach add [<session>] <sub ...|--all>"

  for s in "${want[@]}"; do
    [ -e "$CANONICAL/$s/.git" ] || err "sub-repo '$s' not found at $CANONICAL/$s"
    in_list "$s" ${SUBS[@]+"${SUBS[@]}"} \
      || warn "'$s' is not declared in PLEACH_SUBS (mounting anyway; align the conf with: pleach repos --sync)"
  done

  info "session '$name': mounting ${want[*]}"
  lock
  for s in "${want[@]}"; do
    mount_sub "$name" "$dir" "$s" "$do_bootstrap" || true
  done
  unlock
  echo "✅ '$name' updated. See: pleach ls -l"
}

# ---------------------------------------------------------------------------
FETCHED=""   # repos already updated in this invocation (avoids N fetches on --all)
fetch_base() { # $1 repo, $2 label — advances the LOCAL base ref from origin
  local repo="$1" label="$2" cur
  # shellcheck disable=SC2086  # deliberate split: FETCHED is a space-separated list
  in_list "$repo" $FETCHED && return 0
  FETCHED="$FETCHED $repo"
  # Normal path: base is not checked out here → update the ref directly.
  git -C "$repo" fetch --quiet origin "$BASE:$BASE" 2>/dev/null && return 0
  git -C "$repo" fetch --quiet origin "$BASE" 2>/dev/null \
    || { warn "$label: fetch failed (offline?) — using the local $BASE"; return 1; }
  # Base is checked out (the canonical usually sits on main): fast-forward it.
  cur=$(git -C "$repo" branch --show-current 2>/dev/null || echo "")
  if [ "$cur" = "$BASE" ] && [ -z "$(git -C "$repo" status --porcelain --untracked-files=no 2>/dev/null)" ]; then
    git -C "$repo" merge --ff-only --quiet "origin/$BASE" 2>/dev/null && return 0
  fi
  warn "$label: origin/$BASE moved, but the local $BASE did not — run: git -C $repo pull --ff-only"
  return 1
}

sync_session() { # $1 name, $2 do_fetch, $3 mode (merge|rebase), $4 any_branch, $5 dry — 0 ok, 1 conflicts
  local name="$1" do_fetch="$2" mode="$3" any_branch="$4" dry="${5:-0}"
  local dir="$SESSIONS/$name" branch
  branch=$(session_branch "$name")
  [ -d "$dir" ] || err "session '$name' does not exist at $dir"

  local -a present=()
  local s
  while IFS= read -r s; do [ -n "$s" ] && present+=("$s"); done < <(session_subs "$dir")

  if [ "$dry" -eq 1 ]; then
    echo "● $name  (dry run — $mode from the local $BASE; nothing is changed)"
  else
    echo "● $name  ($mode from the local $BASE)"
  fi
  local wt repo label cur behind conflicts=0 updated=0
  for s in "" ${present[@]+"${present[@]}"}; do
    wt="$dir${s:+/$s}"
    label="${s:-root}"
    [ -e "$wt/.git" ] || continue
    repo=$(repo_path "$s")

    # The target is always the LOCAL base ref (the canonical's main). --fetch only
    # tries to advance it from origin before integrating. In a dry run nothing is
    # touched — not even the base ref.
    [ "$do_fetch" -eq 1 ] && [ "$dry" -eq 0 ] && { fetch_base "$repo" "$label" || true; }

    # Guard rail: we only integrate into the SESSION's branch. A worktree sitting
    # on feat/x (the user switched branches in there) is none of our business.
    cur=$(git -C "$wt" branch --show-current 2>/dev/null || echo "")
    if [ "$cur" != "$branch" ] && [ "$any_branch" -eq 0 ]; then
      warn "$label: on '${cur:-detached HEAD}', not on $branch — SKIPPED (force with: --any-branch)"
      continue
    fi

    behind=$(git -C "$wt" rev-list --count "HEAD..$BASE" 2>/dev/null || echo 0)
    if [ "${behind:-0}" -eq 0 ]; then
      echo "    $label: already up to date"
      continue
    fi
    if [ -n "$(git -C "$wt" status --porcelain --untracked-files=no 2>/dev/null)" ]; then
      warn "$label: $behind commit(s) behind $BASE — SKIPPED (uncommitted changes)"
      continue
    fi

    if [ "$dry" -eq 1 ]; then
      echo "    $label: would $mode +$behind commit(s)"
      updated=$((updated + 1))
      continue
    fi

    if [ "$mode" = "rebase" ]; then
      if git -C "$wt" rebase --quiet "$BASE" >/dev/null 2>&1; then
        echo "    $label: rebased onto $BASE (+$behind)"
        updated=$((updated + 1))
      else
        git -C "$wt" rebase --abort >/dev/null 2>&1 || true
        warn "$label: rebase CONFLICT (reverted) — resolve with: cd $wt && git rebase $BASE"
        conflicts=$((conflicts + 1))
      fi
    else
      if git -C "$wt" merge --no-edit --quiet "$BASE" >/dev/null 2>&1; then
        echo "    $label: merged $BASE (+$behind)"
        updated=$((updated + 1))
      else
        git -C "$wt" merge --abort >/dev/null 2>&1 || true
        warn "$label: merge CONFLICT (reverted) — resolve with: cd $wt && git merge $BASE"
        conflicts=$((conflicts + 1))
      fi
    fi
  done

  # Repos that exist in the canonical but not in this session (e.g. added later).
  local -a missing=()
  for s in ${SUBS[@]+"${SUBS[@]}"}; do
    in_list "$s" ${present[@]+"${present[@]}"} || missing+=("$s")
  done
  if [ ${#missing[@]} -gt 0 ]; then
    warn "workspace sub-repos missing from this session: ${missing[*]} (mount with: pleach add $name ${missing[*]})"
  fi

  if [ "$dry" -eq 1 ]; then
    echo "    ($updated would be updated — run without --dry-run to integrate)"
  else
    echo "    ($updated updated, $conflicts conflict(s))"
  fi
  [ "$conflicts" -eq 0 ]
}

cmd_sync() {
  local name="" do_fetch=0 mode="merge" all=0 any_branch=0 dry=0 yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --rebase)     mode="rebase" ;;
      --merge)      mode="merge" ;;
      --fetch)      do_fetch=1 ;;
      --any-branch) any_branch=1 ;;
      --all)        all=1 ;;
      --dry-run|-n) dry=1 ;;
      --yes|-y)     yes=1 ;;
      -*)           err "unknown flag: $1 (usage: pleach sync [<session>|--all] [--rebase] [--fetch] [--any-branch] [--dry-run] [--yes])" ;;
      *)            [ -z "$name" ] && name="$1" || err "too many arguments" ;;
    esac
    shift
  done
  load_config
  [ "$dry" -eq 1 ] && [ "$do_fetch" -eq 1 ] && warn "--fetch is ignored in a dry run (the $BASE ref is never touched)"

  if [ "$all" -eq 1 ]; then
    [ -z "$name" ] || err "--all does not take a session name"
    local -a names=()
    local n rc=0
    while IFS= read -r n; do [ -n "$n" ] && names+=("$n"); done < <(session_names)
    [ ${#names[@]} -eq 0 ] && { echo "(no sessions in $SESSIONS)"; return 0; }

    # `--all` integrates into MANY worktrees at once — confirm the blast radius
    # first. Non-interactive callers (scripts/agents) must pass --yes; --dry-run
    # is exempt.
    if [ "$dry" -eq 0 ] && [ "$yes" -eq 0 ]; then
      local total=0
      for n in "${names[@]}"; do
        total=$((total + $(session_subs "$SESSIONS/$n" | wc -l | tr -d ' ') + 1))
      done
      if [ -t 0 ]; then
        printf 'Integrate the local %s into %d worktree(s) across %d session(s)? [y/N] ' "$BASE" "$total" "${#names[@]}"
        local reply=""
        read -r reply || true
        case "$reply" in y|Y|yes) ;; *) echo "cancelled."; return 1 ;; esac
      else
        err "sync --all in non-interactive mode requires --yes (check the blast radius first: pleach sync --all --dry-run)"
      fi
    fi

    for n in "${names[@]}"; do
      sync_session "$n" "$do_fetch" "$mode" "$any_branch" "$dry" || rc=1
    done
    return "$rc"
  fi

  if [ -z "$name" ]; then
    name=$(detect_session_name 2>/dev/null) \
      || err "usage: pleach sync <session> [--rebase] [--fetch] [--dry-run]  (or --all)"
  fi
  sync_session "$name" "$do_fetch" "$mode" "$any_branch" "$dry"
}

# ---------------------------------------------------------------------------
conf_subs_line() { # line number of the active PLEACH_SUBS in the conf (empty if none)
  grep -n '^[[:space:]]*PLEACH_SUBS=' "$CANONICAL/$CONF_NAME" 2>/dev/null | head -1 | cut -d: -f1
}

rewrite_conf_subs() { # $@ = subs — surgical edit of the PLEACH_SUBS line
  local ln
  ln=$(conf_subs_line)
  [ -n "$ln" ] || return 1
  local raw
  raw=$(sed -n "${ln}p" "$CANONICAL/$CONF_NAME")
  case "$raw" in
    *')'*) ;;
    *) warn "PLEACH_SUBS spans several lines in $CONF_NAME — leaving it alone; edit by hand"; return 1 ;;
  esac
  local quoted="" s
  for s in "$@"; do quoted="$quoted $(printf '%q' "$s")"; done
  local tmp
  tmp=$(mktemp)
  awk -v ln="$ln" -v new="PLEACH_SUBS=(${quoted# })" 'NR==ln { print new; next } { print }' \
    "$CANONICAL/$CONF_NAME" > "$tmp"
  mv "$tmp" "$CANONICAL/$CONF_NAME"
}

cmd_repos() {
  local do_sync=0 do_bootstrap=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --sync)                      do_sync=1 ;;
      --no-bootstrap|--no-install) do_bootstrap=0 ;;
      -*)                          err "unknown flag: $1 (usage: pleach repos [--sync] [--no-bootstrap])" ;;
      *)                           err "unexpected argument: $1" ;;
    esac
    shift
  done
  load_config

  local -a detected=() new_subs=() gone=()
  local s
  while IFS= read -r s; do [ -n "$s" ] && detected+=("$s"); done < <(detect_subs)
  for s in ${detected[@]+"${detected[@]}"}; do
    in_list "$s" ${SUBS[@]+"${SUBS[@]}"} || new_subs+=("$s")
  done
  for s in ${SUBS[@]+"${SUBS[@]}"}; do
    in_list "$s" ${detected[@]+"${detected[@]}"} || gone+=("$s")
  done

  echo "canonical: $CANONICAL"
  echo "  repos on disk: ${detected[*]:-(none)}"
  if [ "$CONF_DECLARES_SUBS" -eq 1 ]; then
    echo "  PLEACH_SUBS:   ${SUBS[*]:-(empty)}"
  else
    echo "  PLEACH_SUBS:   (not declared — auto-detection)"
  fi
  [ ${#new_subs[@]} -gt 0 ] && echo "  ↑ new on disk, absent from the conf: ${new_subs[*]}"
  [ ${#gone[@]} -gt 0 ] && warn "declared in the conf but missing from disk: ${gone[*]}"

  # Effective list after a --sync: conf + new ones (order preserved).
  local -a effective=(${SUBS[@]+"${SUBS[@]}"} ${new_subs[@]+"${new_subs[@]}"})

  # Conf sync (only if it declares PLEACH_SUBS; with no declaration the
  # auto-detection already picks new repos up and there is nothing to align).
  if [ "$do_sync" -eq 1 ]; then
    if [ ${#new_subs[@]} -eq 0 ]; then
      info "$CONF_NAME is already in sync with disk"
    elif [ "$CONF_DECLARES_SUBS" -eq 0 ]; then
      info "$CONF_NAME does not declare PLEACH_SUBS (auto-detection) — nothing to align"
    elif rewrite_conf_subs "${effective[@]}"; then
      info "$CONF_NAME: PLEACH_SUBS += ${new_subs[*]}"
    fi
  fi

  # Sessions: which effective subs are they missing?
  echo ""
  echo "sessions ($SESSIONS):"
  # One lock for the whole batch (not per worktree) — serializes this --sync
  # against any concurrent new/rm/add.
  [ "$do_sync" -eq 1 ] && [ -d "$SESSIONS" ] && lock
  local n dir found=0 pending=0
  local -a present=() missing=()
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    found=1
    dir="$SESSIONS/$n"
    present=(); missing=()
    while IFS= read -r s; do [ -n "$s" ] && present+=("$s"); done < <(session_subs "$dir")
    for s in ${effective[@]+"${effective[@]}"}; do
      in_list "$s" ${present[@]+"${present[@]}"} || missing+=("$s")
    done
    if [ ${#missing[@]} -eq 0 ]; then
      echo "  ✓ $n — complete (${#present[@]} sub-repos)"
      continue
    fi
    pending=$((pending + 1))
    echo "  ← $n — missing: ${missing[*]}"
    if [ "$do_sync" -eq 1 ]; then
      for s in "${missing[@]}"; do
        mount_sub "$n" "$dir" "$s" "$do_bootstrap" || true
      done
    fi
  done < <(session_names)
  [ "$found" -eq 0 ] && echo "  (no sessions)"
  [ "$do_sync" -eq 1 ] && [ -n "$LOCK_PATH" ] && unlock

  echo ""
  if [ "$do_sync" -eq 1 ]; then
    echo "✅ workspace aligned."
  elif [ "$pending" -gt 0 ] || [ ${#new_subs[@]} -gt 0 ]; then
    echo "Align everything (conf + sessions): pleach repos --sync"
  else
    echo "Everything is in sync."
  fi
}

# ---------------------------------------------------------------------------
worktree_dirt() { # $1 = worktree, $2 = session dir when $1 is the ROOT worktree
  # Work that would be LOST if this worktree were removed. Untracked files count,
  # and that is the whole point: they exist nowhere else, which is exactly why
  # `git worktree remove` refuses to delete them. Every check here used to read
  # --untracked-files=no, so a session whose only content was new files reported as
  # empty, `ls -l` called it "fully integrated — removable", and `rm` deleted it
  # with a green tick and exit 0. A coding agent produces new files, and this tool
  # exists to run coding agents.
  #
  # Two things are pleach's own footprint rather than the user's work, and are
  # filtered out: .session-env, and the mounted sub-repo directories, which the
  # root worktree sees as untracked whenever the root repo does not ignore them.
  local wt="$1" sessdir="${2:-}" line f
  local -a skip=(".session-env")
  if [ -n "$sessdir" ]; then
    while IFS= read -r f; do [ -n "$f" ] && skip+=("$f"); done < <(session_subs "$sessdir")
  fi
  git -C "$wt" status --porcelain 2>/dev/null | while IFS= read -r line; do
    [ -n "$line" ] || continue
    f="${line:3}"; f="${f%/}"
    in_list "$f" ${skip[@]+"${skip[@]}"} && continue
    printf '%s\n' "$line"
  done
}

session_identity_problem() { # $1 name — echoes why the folder cannot be judged, if so
  # Identity comes from the folder name, so a rename silently retargets every check:
  # the branch lookup misses, the session reads as empty, and rm deletes it. Rather
  # than guess, say that the two disagree.
  local dir="$SESSIONS/$1" recorded
  recorded=$(session_env_get "$dir" PLEACH_NAME)
  [ -n "$recorded" ] || return 1          # created before this was recorded
  [ "$recorded" = "$1" ] && return 1
  printf '%s' "the folder is '$1' but its .session-env says '$recorded' — the branches are session/$recorded, so nothing here can be judged by name. Rename it back: mv '$dir' '$SESSIONS/$recorded'"
  return 0
}

session_problems() { # $1 name — echoes pending work (one per line); rc 0 if none
  # Criterion shared by rm and prune: uncommitted changes in any worktree, or
  # commits on session/<name> not yet integrated into the local BASE.
  local name="$1" dir="$SESSIONS/$1" branch
  branch=$(session_branch "$name")
  local -a present=()
  local s wt repo label ahead count=0
  while IFS= read -r s; do [ -n "$s" ] && present+=("$s"); done < <(session_subs "$dir")
  for s in "" ${present[@]+"${present[@]}"}; do
    repo=$(repo_path "$s"); label="${s:-root}"
    wt="$dir${s:+/$s}"
    [ -e "$wt/.git" ] || continue
    if [ -n "$(worktree_dirt "$wt" "$([ -z "$s" ] && printf '%s' "$dir")")" ]; then
      echo "$label: uncommitted or untracked changes"
      count=$((count + 1))
    fi
    ahead=$(git -C "$repo" rev-list --count "$BASE..$branch" 2>/dev/null || echo 0)
    if [ "${ahead:-0}" -gt 0 ]; then
      echo "$label: $ahead commit(s) on $branch not integrated into $BASE"
      count=$((count + 1))
    fi
  done
  [ "$count" -eq 0 ]
}

cmd_rm() {
  local name="" force=0 reap=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1 ;;
      --reap)  reap=1 ;;
      -*)      err "unknown flag: $1" ;;
      *)       [ -z "$name" ] && name="$1" || err "too many arguments" ;;
    esac
    shift
  done
  [ -n "$name" ] || err "usage: pleach rm <name> [--force] [--reap]"
  load_config
  # Before anything destructive: refuse when the folder and its own record disagree.
  # --force does not override this, because there is nothing to override — the guard
  # rails cannot be evaluated at all, so "force" would mean "delete blind".
  local id_problem
  if id_problem=$(session_identity_problem "$name"); then
    err "cannot remove '$name': $id_problem"
  fi
  local dir="$SESSIONS/$name" branch
  branch=$(session_branch "$name")
  [ -d "$dir" ] || err "session '$name' does not exist at $dir"

  local -a present=()
  local s repo label
  while IFS= read -r s; do [ -n "$s" ] && present+=("$s"); done < <(session_subs "$dir")

  # Read the port block BEFORE the worktrees go: after removal the .session-env
  # is gone and a process still bound to that block becomes untraceable.
  local port listeners
  port=$(session_env_get "$dir" PLEACH_PORT_BASE)
  listeners=$(session_listeners "${port:-}")

  # Safety: refuse if there is unsaved / unintegrated work.
  local problems=""
  if ! problems=$(session_problems "$name") && [ "$force" -eq 0 ]; then
    echo "pleach: session '$name' has pending work:" >&2
    printf '%s\n' "$problems" | sed 's/^/  - /' >&2
    err "use --force to remove anyway (the worktrees go; branches with unintegrated commits are preserved)"
  fi

  lock
  # Subs first, root last (the root worktree contains the subs').
  for s in ${present[@]+"${present[@]}"}; do
    git -C "$CANONICAL/$s" worktree remove --force "$dir/$s" 2>/dev/null \
      || warn "worktree remove failed in $s (cleaned up via prune)"
    git -C "$CANONICAL/$s" worktree prune
  done
  if [ -e "$dir/.git" ]; then
    git -C "$CANONICAL" worktree remove --force "$dir" 2>/dev/null || true
  fi
  git -C "$CANONICAL" worktree prune
  rm -rf "$dir"
  rm -f "$dir.code-workspace"
  rm -f "$SESSIONS/.pleach-building.$name"   # the session is gone; its marker cannot outlive it
  unlock

  # Branches: delete only the ones fully integrated into $BASE; keep the rest.
  # (merge-base rather than `branch -d`: -d compares against the canonical repo's
  #  current HEAD, which may sit on some unrelated working branch.)
  for s in "" ${present[@]+"${present[@]}"}; do
    repo=$(repo_path "$s"); label="${s:-root}"
    git -C "$repo" show-ref --verify --quiet "refs/heads/$branch" || continue
    if git -C "$repo" merge-base --is-ancestor "$branch" "$BASE" 2>/dev/null; then
      git -C "$repo" branch -D "$branch" >/dev/null 2>&1 || true
      info "$label: branch $branch deleted (integrated into $BASE)"
    else
      warn "$label: branch $branch preserved (unintegrated commits — delete with: git -C $repo branch -D $branch)"
    fi
  done

  # Sockets outlive worktrees. Reporting is the default; killing is opt-in, like
  # every other destructive step here.
  if [ -n "$listeners" ]; then
    local pid comm
    if [ "$reap" -eq 1 ]; then
      while IFS="$(printf '\t')" read -r pid comm; do
        [ -n "$pid" ] || continue
        if kill "$pid" 2>/dev/null; then
          info "reaped ${comm:-process} (pid $pid) from port block $port"
        else
          warn "could not kill ${comm:-process} (pid $pid) — kill it by hand"
        fi
      done <<EOF
$listeners
EOF
    else
      warn "process(es) still listening in the freed port block $port-$((port + 99)):"
      printf '%s\n' "$listeners" | awk -F'\t' '{printf "      %s (pid %s)\n", ($2 == "?" ? "process" : $2), $1}' >&2
      warn "the block will not be reusable until they exit — kill them with: pleach rm $name --reap"
    fi
  fi

  echo "✅ Session '$name' removed."
}

# ---------------------------------------------------------------------------
cmd_prune() { # hygiene: remove sessions whose work is fully integrated (dry run by default)
  local apply=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --apply|--yes|-y) apply=1 ;;
      -*) err "unknown flag: $1 (usage: pleach prune [--apply])" ;;
      *)  err "unexpected argument: $1 (usage: pleach prune [--apply])" ;;
    esac
    shift
  done
  load_config
  local n problems found=0
  local -a removable=()
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    found=1
    if problems=$(session_problems "$n"); then
      removable+=("$n")
      echo "  ✓ $n — fully integrated (removable)"
    else
      echo "  ● $n — pending work:"
      printf '%s\n' "$problems" | sed 's/^/      - /'
    fi
  done < <(session_names)
  [ "$found" -eq 0 ] && { echo "(no sessions in $SESSIONS)"; return 0; }
  echo ""
  if [ ${#removable[@]} -eq 0 ]; then
    echo "Nothing to remove — every session has pending work."
    echo "(\"integrated\" is judged against the LOCAL $BASE — merges that only landed on the remote need a git fetch first)"
    return 0
  fi
  if [ "$apply" -eq 0 ]; then
    echo "Dry run — remove ${#removable[@]} session(s): pleach prune --apply"
    return 0
  fi
  for n in "${removable[@]}"; do
    cmd_rm "$n"
  done
}

# ---------------------------------------------------------------------------
cmd_clean() { # purge rematerialized build/dependency artifacts (dry run by default)
  local name="" apply=0 do_bootstrap=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --apply|--yes|-y) apply=1 ;;
      --bootstrap)      do_bootstrap=1; apply=1 ;;
      -*) err "unknown flag: $1 (usage: pleach clean [<session>] [--apply] [--bootstrap])" ;;
      *)  [ -z "$name" ] && name="$1" || err "too many arguments" ;;
    esac
    shift
  done
  load_config
  if [ -z "$name" ]; then
    name=$(detect_session_name 2>/dev/null) \
      || err "usage: pleach clean <session> [--apply] [--bootstrap]  (inside a session the name is inferred)"
  fi
  local dir="$SESSIONS/$name"
  [ -d "$dir" ] || err "session '$name' does not exist at $dir"

  local -a targets=() skipped=()
  local d
  while IFS= read -r -d '' d; do
    # We only delete what git IGNORES — a tracked dist/ is never touched.
    if git -C "$(dirname "$d")" check-ignore -q "$d" 2>/dev/null; then
      targets+=("$d")
    else
      skipped+=("$d")
    fi
  done < <(find "$dir" -type d \( -name node_modules -o -name .next -o -name .open-next \
      -o -name .wrangler -o -name dist -o -name build -o -name target \
      -o -name .venv -o -name vendor -o -name .turbo \) -prune -print0)

  if [ ${#targets[@]} -eq 0 ]; then
    echo "Nothing to clean in '$name'."
  else
    du -sh "${targets[@]}" 2>/dev/null | sed "s|$dir/|  |"
    echo "  total: $(du -sk "${targets[@]}" 2>/dev/null | awk '{s+=$1} END {printf "%.0f MB", s/1024}')"
  fi
  [ ${#skipped[@]} -gt 0 ] && warn "not ignored by git (preserved): ${skipped[*]}"

  if [ "$apply" -eq 0 ]; then
    [ ${#targets[@]} -gt 0 ] && echo "Dry run — delete with: pleach clean $name --apply  (--bootstrap reinstalls afterwards)"
    return 0
  fi
  local t
  for t in ${targets[@]+"${targets[@]}"}; do rm -rf "$t"; done
  [ ${#targets[@]} -gt 0 ] && info "${#targets[@]} directory(ies) removed"
  [ "$do_bootstrap" -eq 1 ] && run_bootstrap "$dir" ""
  echo "✅ '$name' cleaned."
}

# ---------------------------------------------------------------------------
run_in_dir() { # $1 dir; rest = command (1 arg → bash -c; N args → literal)
  local d="$1"
  shift
  # `--` or bash parses a leading dash as its OWN option and the command never runs,
  # which would make `pleach each -- '-x …'` an escape hatch that does not escape.
  if [ $# -eq 1 ]; then ( cd "$d" && bash -c -- "$1" ); else ( cd "$d" && "$@" ); fi
}

cmd_each() { # runs a command in the canonical and in every session
  # `each` had no flag parsing at all, so anything starting with a dash was handed
  # to bash -c as a command. `--` keeps the escape hatch for a command that really
  # does start with one.
  local repos=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --repos) repos=1 ;;
      --)      shift; break ;;
      -*)      err "unknown flag: $1 (usage: pleach each [--repos] '<command>')" ;;
      *)       break ;;
    esac
    shift
  done
  [ $# -ge 1 ] || err "usage: pleach each [--repos] '<command>'  (or: pleach each cmd arg …)"
  load_config

  # The targets are built first so the order is stated in one place: the canonical
  # before the sessions, and within each, the root before its sub-repos — the order
  # sync, ls -l and doctor already use.
  local n s
  local -a labels=() dirs=()
  if [ "$repos" -eq 1 ]; then
    labels+=("canonical · root"); dirs+=("$CANONICAL")
    # SUBS, not detect_subs: it is the resolved list — the conf's PLEACH_SUBS when
    # it declares one, auto-detection otherwise. Walking the disk instead would
    # enter a vendored or unrelated repo the workspace deliberately left out.
    for s in ${SUBS[@]+"${SUBS[@]}"}; do
      [ -n "$s" ] || continue
      [ -e "$CANONICAL/$s/.git" ] || continue
      labels+=("canonical · $s"); dirs+=("$CANONICAL/$s")
    done
  else
    labels+=("canonical"); dirs+=("$CANONICAL")
  fi
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    if [ "$repos" -eq 1 ]; then
      labels+=("$n · root"); dirs+=("$SESSIONS/$n")
      while IFS= read -r s; do
        [ -n "$s" ] || continue
        labels+=("$n · $s"); dirs+=("$SESSIONS/$n/$s")
      done < <(session_subs "$SESSIONS/$n")
    else
      labels+=("$n"); dirs+=("$SESSIONS/$n")
    fi
  done < <(session_names)

  local rc=0 i
  for ((i = 0; i < ${#labels[@]}; i++)); do
    echo "● ${labels[$i]}  (${dirs[$i]})"
    run_in_dir "${dirs[$i]}" "$@" || { rc=1; warn "${labels[$i]}: the command returned an error"; }
  done
  return "$rc"
}

# ---------------------------------------------------------------------------
ls_short() {
  local n dir idx port count found=0
  printf '  %-24s %4s  %-10s %6s\n' "NAME" "IDX" "PORTS" "REPOS"
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    found=1
    dir="$SESSIONS/$n"
    idx=$(session_env_get "$dir" PLEACH_INDEX)
    port=$(session_env_get "$dir" PLEACH_PORT_BASE)
    count=$(session_subs "$dir" | wc -l | tr -d ' ')
    printf '● %-24s %4s  %-10s %6s\n' "$n" "${idx:-?}" "${port:-?}+" "$((count + 1))"
  done < <(session_names)
  if [ "$found" -eq 0 ]; then
    echo "(no sessions in $SESSIONS)"
    return 0
  fi
  echo ""
  echo "($SESSIONS — 'pleach ls -l' for branches, commits and changes per repo)"
}

ls_long() {
  local found=0 n dir idx port cut_from s wt ahead behind dirty last marks clean last_activity
  local -a present=()
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    found=1
    dir="$SESSIONS/$n"
    idx=$(session_env_get "$dir" PLEACH_INDEX)
    port=$(session_env_get "$dir" PLEACH_PORT_BASE)
    cut_from=$(session_env_get "$dir" PLEACH_BASE_REF)
    # Lineage is only worth the line when it is a surprise: a session stacked on
    # another one integrates against a moving target, and that changes how you
    # read everything below it.
    if [ -n "$cut_from" ] && [ "$cut_from" != "$BASE" ]; then
      echo "● $n  (index ${idx:-?}, ports ${port:-?}+, cut from $cut_from)  $dir/"
    else
      echo "● $n  (index ${idx:-?}, ports ${port:-?}+)  $dir/"
    fi
    present=()
    while IFS= read -r s; do [ -n "$s" ] && present+=("$s"); done < <(session_subs "$dir")
    clean=1
    last_activity=""
    for s in "" ${present[@]+"${present[@]}"}; do
      wt="$dir${s:+/$s}"
      [ -e "$wt/.git" ] || continue
      ahead=$(git -C "$wt" rev-list --count "$BASE..HEAD" 2>/dev/null || echo "?")
      behind=$(git -C "$wt" rev-list --count "HEAD..$BASE" 2>/dev/null || echo "?")
      dirty=$(worktree_dirt "$wt" "$([ -z "$s" ] && printf '%s' "$dir")" | wc -l | tr -d ' ')
      last=$(git -C "$wt" log -1 --format='%ad' --date=short 2>/dev/null || echo "")
      if [ -n "$last" ] && [[ "$last" > "$last_activity" ]]; then last_activity="$last"; fi
      marks=""
      [ "${ahead:-0}" != "0" ] && marks+=" +$ahead commits"
      [ "${dirty:-0}" != "0" ] && marks+=" ✎$dirty changes"
      [ "${behind:-0}" != "0" ] && marks+=" ↓$behind behind"
      if [ "${ahead:-0}" != "0" ] || [ "${dirty:-0}" != "0" ]; then clean=0; fi
      echo "    ${s:-root}: $(git -C "$wt" branch --show-current 2>/dev/null)${marks}"
    done
    # "fully integrated — removable" reads as "your work is merged, this is safe to
    # drop". Over a session whose creation was interrupted it describes nothing:
    # there was never any work, and what is missing is repos or dependencies.
    if session_incomplete "$n"; then
      echo "    ⚠ creation never finished — pleach add $n --all && pleach clean $n --bootstrap"
    elif [ "$clean" -eq 1 ]; then
      echo "    ✓ fully integrated — removable (pleach prune)${last_activity:+ · last activity: $last_activity}"
    elif [ -n "$last_activity" ]; then
      echo "    (last activity: $last_activity)"
    fi
  done < <(session_names)
  if [ "$found" -eq 0 ]; then echo "(no sessions in $SESSIONS)"; fi
}

ls_json() {
  # The machine-readable surface. pleach deliberately ships no MCP server: the
  # agent that would call one lives INSIDE a session, and a session's lifecycle
  # is decided outside it. What an agent legitimately needs is to read the map —
  # and a shell-out to this is enough, in any tool that can run a command.
  local first=1 n dir idx port slug base_ref s subs_json
  printf '{\n'
  printf '  "canonical": "%s",\n' "$(json_escape "$CANONICAL")"
  printf '  "sessions_dir": "%s",\n' "$(json_escape "$SESSIONS")"
  printf '  "base": "%s",\n' "$(json_escape "$BASE")"
  printf '  "sessions": [\n'
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    dir="$SESSIONS/$n"
    idx=$(session_env_get "$dir" PLEACH_INDEX)
    port=$(session_env_get "$dir" PLEACH_PORT_BASE)
    slug=$(session_env_get "$dir" PLEACH_SLUG)
    base_ref=$(session_env_get "$dir" PLEACH_BASE_REF)
    subs_json=""
    while IFS= read -r s; do
      [ -n "$s" ] || continue
      subs_json="$subs_json${subs_json:+, }\"$(json_escape "$s")\""
    done < <(session_subs "$dir")
    [ "$first" -eq 1 ] || printf ',\n'
    first=0
    printf '    {"name": "%s", "index": %s, "port_base": %s, "slug": "%s", "cut_from": "%s", "path": "%s", "branch": "%s", "subs": [%s]}' \
      "$(json_escape "$n")" "${idx:-null}" "${port:-null}" "$(json_escape "$slug")" \
      "$(json_escape "${base_ref:-$BASE}")" \
      "$(json_escape "$dir")" "$(json_escape "$(session_branch "$n")")" "$subs_json"
  done < <(session_names)
  printf '\n  ]\n}\n'
}

cmd_ls() {
  local long=0 as_json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -l|--long|--repos) long=1 ;;
      -s|--short)        long=0 ;;
      --json)            as_json=1 ;;
      *)                 err "unknown flag: $1 (usage: pleach ls [-l|--json])" ;;
    esac
    shift
  done
  load_config
  if [ "$as_json" -eq 1 ]; then ls_json
  elif [ "$long" -eq 1 ]; then ls_long
  else ls_short; fi
}

# ---------------------------------------------------------------------------
cmd_path() { # prints where a session lives — the primitive the shell wrapper builds on
  local name="" canonical=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --canonical) canonical=1 ;;
      -*)          err "unknown flag: $1 (usage: pleach path [<session>] [--canonical])" ;;
      *)           [ -z "$name" ] && name="$1" || err "too many arguments" ;;
    esac
    shift
  done
  load_config
  if [ "$canonical" -eq 1 ]; then printf '%s\n' "$CANONICAL"; return 0; fi
  if [ -z "$name" ]; then
    name=$(detect_session_name 2>/dev/null) \
      || err "usage: pleach path <session>  (inside a session the name is inferred; --canonical for the canonical)"
  fi
  [ -d "$SESSIONS/$name" ] || err "session '$name' does not exist at $SESSIONS/$name"
  printf '%s\n' "$SESSIONS/$name"
}

cmd_cd() {
  # A child process cannot change its parent's directory. Rather than pretend
  # otherwise, say so and hand over the one-line fix.
  err "'cd' needs the shell wrapper — a child process cannot change your shell's directory.
  Add to ~/.zshrc or ~/.bashrc:  eval \"\$(pleach shell-init)\"
  Until then:                    cd \"\$(pleach path <session>)\""
}

cmd_shell_init() {
  cat <<'EOF'
# pleach shell integration. Add to ~/.zshrc or ~/.bashrc:
#   eval "$(pleach shell-init)"
# It adds `pleach cd [session]`, which the binary alone cannot do: only a function
# running in your own shell can change that shell's directory. Everything else is
# handed straight to the real command.
pleach() {
  if [ "${1:-}" = "cd" ]; then
    shift
    local _pleach_dir
    _pleach_dir=$(command pleach path "$@") || return $?
    cd "$_pleach_dir" || return $?
    # Bring the session's ports and identity into this shell.
    if [ -f .session-env ]; then . ./.session-env; fi
    return 0
  fi
  command pleach "$@"
}
EOF
}

cmd_completions() {
  local shell="${1:-}"
  [ -n "$shell" ] || err "usage: pleach completions <bash|zsh>"
  case "$shell" in
    bash) cat <<'EOF'
# pleach bash completion. Add to ~/.bashrc:
#   eval "$(pleach completions bash)"
_pleach_commands="init new open ls add sync rm prune clean each conflicts repos path cd doctor skill completions shell-init install update version help"
_pleach_sessions() { pleach ls --json 2>/dev/null | sed -nE 's/.*"name": "([^"]+)".*/\1/p'; }
_pleach() {
  local cur="${COMP_WORDS[COMP_CWORD]}"
  if [ "$COMP_CWORD" -eq 1 ]; then
    COMPREPLY=($(compgen -W "$_pleach_commands" -- "$cur"))
    return
  fi
  case "${COMP_WORDS[1]}" in
    open|sync|rm|clean|add|path|cd)
      [ "$COMP_CWORD" -eq 2 ] && COMPREPLY=($(compgen -W "$(_pleach_sessions)" -- "$cur")) ;;
    help)        COMPREPLY=($(compgen -W "$_pleach_commands config" -- "$cur")) ;;
    completions) COMPREPLY=($(compgen -W "bash zsh" -- "$cur")) ;;
  esac
}
complete -F _pleach pleach
EOF
      ;;
    zsh) cat <<'EOF'
# pleach zsh completion. Add to ~/.zshrc:
#   eval "$(pleach completions zsh)"
_pleach() {
  local -a cmds
  cmds=(init new open ls add sync rm prune clean each conflicts repos path cd doctor skill completions shell-init install update version help)
  if (( CURRENT == 2 )); then
    _describe 'pleach command' cmds
    return
  fi
  case "${words[2]}" in
    open|sync|rm|clean|add|path|cd)
      (( CURRENT == 3 )) && _values 'session' ${(f)"$(pleach ls --json 2>/dev/null | sed -nE 's/.*"name": "([^"]+)".*/\1/p')"} ;;
    help)        _values 'topic' $cmds config ;;
    completions) _values 'shell' bash zsh ;;
  esac
}
compdef _pleach pleach
EOF
      ;;
    *) err "unknown shell: $shell (supported: bash, zsh)" ;;
  esac
}

# ---------------------------------------------------------------------------
report_conflict() { # $1 repo, $2 label, $3 refA, $4 refB, $5 nameA, $6 nameB
                    # echoes the block on stdout; rc 0 only when it reported one
  local out mt_rc=0 files tree cf
  # --write-tree builds the merged tree in the object store and prints its id; the
  # working tree, the index and every branch stay untouched.
  out=$(git -C "$1" merge-tree --write-tree --name-only "$3" "$4" 2>/dev/null) || mt_rc=$?
  [ "$mt_rc" -eq 0 ] && return 1
  # rc 1 means conflict, which is the answer we want. Anything else is a git ERROR
  # (no common ancestor, say) — stepping over it in silence would be another blind
  # spot inside the command meant to remove them.
  if [ "$mt_rc" -gt 1 ]; then
    warn "$2: merge-tree failed (rc $mt_rc) between $3 and $4 — this was NOT checked"
    return 1
  fi
  # Line 1 is the tree id; the conflicted paths follow, up to a blank line.
  files=$(printf '%s\n' "$out" | awk 'NR > 1 { if ($0 == "") exit; print }')
  [ -n "$files" ] || return 1
  printf '  %s <-> %s   (%s)\n' "$5" "$6" "$2"
  tree=$(printf '%s\n' "$out" | head -1)
  while IFS= read -r cf; do
    [ -n "$cf" ] || continue
    conflict_detail "$1" "$tree" "$cf" "$5" "$6"
  done <<EOF
$files
EOF
  return 0
}

session_landed() { # 0 when $2's work is already in $BASE, judged inside repo $1
  # Two shapes, and only one of them is exact. A true merge makes the branch an
  # ancestor of the base, which is decidable. A squash or a rebase does not, and
  # then the only evidence left is that branch and base now hold the same content
  # — true right after the landing, and no longer true once the base moves on.
  # The residual is stated in `help conflicts` rather than implied by silence.
  git -C "$1" show-ref --verify --quiet "refs/heads/$BASE" || return 1
  git -C "$1" merge-base --is-ancestor "$2" "$BASE" 2>/dev/null && return 0
  git -C "$1" diff --quiet "$BASE" "$2" 2>/dev/null
}

conflict_detail() { # $1 repo, $2 merged tree, $3 path, $4 session a, $5 session b
  # merge-tree --write-tree already WROTE the merged blobs into the object store,
  # conflict markers and all, and this command printed the tree id and discarded
  # it. Reading them back is the whole difference between naming the file and
  # naming the change: a path cannot tell two edits to adjacent lines from a
  # rewrite, so the reader had to go and look anyway.
  local body
  body=$(git -C "$1" show "$2:$3" 2>/dev/null | awk -v P="$3" -v A="$4" -v B="$5" '
    /^<<<<<<< / { r++; if (r <= 3) locs = locs (locs ? ", " : "") NR; side = 1; next }
    /^=======$/ { if (side == 1) { side = 2; next } }
    /^>>>>>>> / { if (side)      { side = 0; next } }
    {
      if (side == 1 && r == 1 && na < 3) a[++na] = $0
      else if (side == 2 && r == 1 && nb < 3) b[++nb] = $0
    }
    END {
      if (r == 0) exit
      printf "        %s   %d region%s, at line%s %s%s\n", \
        P, r, (r == 1 ? "" : "s"), (r == 1 ? "" : "s"), locs, (r > 3 ? ", …" : "")
      for (i = 1; i <= na; i++) printf "            %s │ %s\n", A, a[i]
      for (i = 1; i <= nb; i++) printf "            %s │ %s\n", B, b[i]
      if (na >= 3 || nb >= 3) print "            …"
    }
  ') || body=""
  if [ -n "$body" ]; then
    printf '%s\n' "$body"
  else
    # Nothing to read back: a rename/delete conflict, or a binary file. The path
    # alone is still the honest answer there.
    printf '        %s\n' "$3"
  fi
}

git_supports_merge_tree() {
  # `merge-tree --write-tree` landed in git 2.38. Below that only the overlap
  # heuristic is available, and conflicts says so rather than quietly reporting
  # less than it claims to.
  local v major minor
  v=$(git --version 2>/dev/null | awk '{print $3}')
  major=${v%%.*}
  minor=${v#*.}; minor=${minor%%.*}
  case "${major:-x}${minor:-x}" in *[!0-9]*|"") return 1 ;; esac
  [ "$major" -gt 2 ] && return 0
  [ "$major" -eq 2 ] && [ "$minor" -ge 38 ]
}

cmd_conflicts() {
  # Worktrees move collisions from the working tree to merge time, which is the
  # whole point — but they also hide them until then. This is the only place you
  # can see the overlap before paying for it.
  load_config
  # Global, not local: the EXIT trap runs after this function has returned, when a
  # local would already be out of scope — and under `set -u` that turns cleanup
  # into an "unbound variable" failure that silently becomes the exit code.
  TMPFILE=$(mktemp)
  trap 'rm -f "${TMPFILE:-}"' EXIT
  local tmp="$TMPFILE"

  local -a names=()
  local n
  while IFS= read -r n; do [ -n "$n" ] && names+=("$n"); done < <(session_names)

  # -------------------------------------------------------------------------
  # 1. What would REALLY conflict.
  #
  # Not a proxy. git performs the three-way merge in memory and answers. Two
  # sessions editing distant regions of one file merge cleanly, and reporting
  # those as conflicts would only train you to ignore the command.
  # -------------------------------------------------------------------------
  local real=0 degraded=0
  if [ ${#names[@]} -ge 2 ] && git_supports_merge_tree; then
    local i j a b repo label s ba bb block
    local -a subs_a=() subs_b=() pair=()
    for ((i = 0; i < ${#names[@]}; i++)); do
      for ((j = i + 1; j < ${#names[@]}; j++)); do
        a="${names[$i]}"; b="${names[$j]}"
        ba=$(session_branch "$a"); bb=$(session_branch "$b")
        # The repos to compare are the ones mounted in BOTH sessions, not the ones
        # declared in the conf: a sub mounted with `pleach add` and still outside
        # PLEACH_SUBS would be skipped, and a blind spot inside the command that
        # exists to remove them is worth nothing.
        subs_a=(); subs_b=(); pair=()
        while IFS= read -r s; do [ -n "$s" ] && subs_a+=("$s"); done < <(session_subs "$SESSIONS/$a")
        while IFS= read -r s; do [ -n "$s" ] && subs_b+=("$s"); done < <(session_subs "$SESSIONS/$b")
        for s in ${subs_a[@]+"${subs_a[@]}"}; do
          in_list "$s" ${subs_b[@]+"${subs_b[@]}"} && pair+=("$s")
        done
        for s in "" ${pair[@]+"${pair[@]}"}; do
          repo=$(repo_path "$s"); label="${s:-root}"
          [ -e "$repo/.git" ] || continue
          git -C "$repo" show-ref --verify --quiet "refs/heads/$ba" || continue
          git -C "$repo" show-ref --verify --quiet "refs/heads/$bb" || continue
          # A session whose work has LANDED conflicts with nobody, and saying it
          # does is how a command earns being ignored. The pair check compares tip
          # against tip and never consulted the base, so a merged session kept
          # conflicting for as long as its folder existed — while the overlap
          # section below, which does diff against the base, had already gone quiet
          # about the same file.
          session_landed "$repo" "$ba" && continue
          session_landed "$repo" "$bb" && continue
          if block=$(report_conflict "$repo" "$label" "$ba" "$bb" "$a" "$b"); then
            if [ "$real" -eq 0 ]; then
              echo "WOULD CONFLICT — git's own three-way merge says these cannot both land as they are:"
              echo ""
            fi
            real=$((real + 1))
            printf '%s\n' "$block"
          fi
        done
      done
    done
  elif [ ${#names[@]} -ge 2 ]; then
    degraded=1
  fi

  # A pair check answers "can these two land TOGETHER". It never answered "can this
  # one land AT ALL" — and once a session's counterpart has landed, that is the only
  # question left. Skipping landed sessions without asking it turned a stale
  # WOULD CONFLICT into "No file is being edited in more than one session" over a
  # session git flatly refuses to merge: a nuisance traded for a false all-clear.
  if [ ${#names[@]} -ge 1 ] && git_supports_merge_tree; then
    local bn repo_b label_b sb block_b
    local -a subs_n=()
    for bn in ${names[@]+"${names[@]}"}; do
      subs_n=()
      while IFS= read -r sb; do [ -n "$sb" ] && subs_n+=("$sb"); done < <(session_subs "$SESSIONS/$bn")
      for sb in "" ${subs_n[@]+"${subs_n[@]}"}; do
        repo_b=$(repo_path "$sb"); label_b="${sb:-root}"
        [ -e "$repo_b/.git" ] || continue
        git -C "$repo_b" show-ref --verify --quiet "refs/heads/$(session_branch "$bn")" || continue
        git -C "$repo_b" show-ref --verify --quiet "refs/heads/$BASE" || continue
        session_landed "$repo_b" "$(session_branch "$bn")" && continue
        # The session is the FIRST ref as well as the first name: refs and names are
        # positional, and crossing them attributes each side's content to the other.
        if block_b=$(report_conflict "$repo_b" "$label_b" "$(session_branch "$bn")" "$BASE" "$bn" "$BASE"); then
          if [ "$real" -eq 0 ]; then
            echo "WOULD CONFLICT — git's own three-way merge says these cannot both land as they are:"
            echo ""
          fi
          real=$((real + 1))
          printf '%s\n' "$block_b"
        fi
      done
    done
  fi
  [ "$real" -gt 0 ] && echo ""

  local dir s wt label f
  local -a present=()
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    dir="$SESSIONS/$n"
    present=()
    while IFS= read -r s; do [ -n "$s" ] && present+=("$s"); done < <(session_subs "$dir")
    for s in "" ${present[@]+"${present[@]}"}; do
      wt="$dir${s:+/$s}"; label="${s:-root}"
      [ -e "$wt/.git" ] || continue
      # Committed work since branching, plus what is still uncommitted: both are
      # edits this session owns and neither is visible to the others.
      {
        git -C "$wt" diff --name-only "$BASE...HEAD" 2>/dev/null || true
        git -C "$wt" status --porcelain --untracked-files=no 2>/dev/null | cut -c4- || true
      } | while IFS= read -r f; do
        [ -n "$f" ] || continue
        printf '%s/%s\t%s\n' "$label" "$f" "$n"
      done >> "$tmp"
    done
  done < <(session_names)

  # sort -u sorts whole lines, so identical paths land together and exact
  # duplicates (same file, same session) collapse. What `uniq -d` then reports on
  # the path column is therefore precisely "touched by more than one session".
  sort -u "$tmp" -o "$tmp"
  local overlaps
  overlaps=$(cut -f1 "$tmp" | uniq -d)

  if [ -n "$overlaps" ]; then
    if [ "$real" -gt 0 ]; then
      echo "Also touched by more than one session (git merges these cleanly, or they are"
      echo "not committed yet — the check above only sees committed work):"
    else
      echo "Touched by more than one session — git merges these cleanly today, or they are"
      echo "not committed yet, so the merge cannot be decided:"
    fi
    echo ""
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      printf '  %s\n' "$f"
      awk -F'\t' -v want="$f" '$1 == want { printf "        %s\n", $2 }' "$tmp"
    done <<EOF
$overlaps
EOF
    echo ""
  fi

  # -------------------------------------------------------------------------
  # 3. The same numbered slot, claimed by different filenames.
  #
  # git's merge cannot see this one and never will: two sessions adding
  # 0004_billing.sql and 0004_last_login.sql are adding DIFFERENT files, so the
  # merge is clean, exits 0, and lands two migrations both numbered 0004. The
  # sequence is a shared namespace living inside the filename, and nothing in git
  # models it. Covers the common NNNN_name / NNN-name convention only.
  # -------------------------------------------------------------------------
  local slots
  slots=$(awk -F'\t' '
    {
      path = $1; sess = $2
      n = split(path, p, "/"); base = p[n]
      dir = substr(path, 1, length(path) - length(base))
      if (base ~ /^[0-9]+[-_]/) {
        match(base, /^[0-9]+/); pref = substr(base, RSTART, RLENGTH)
        key = dir "|" pref
        pair = base "\t" sess
        if (!(key SUBSEP pair in seen)) {
          seen[key SUBSEP pair] = 1
          rows[key] = rows[key] sprintf("        %-28s (%s)\n", base, sess)
          if (!(key SUBSEP base in ub)) { ub[key SUBSEP base] = 1; nbase[key]++ }
          if (!(key SUBSEP sess in us)) { us[key SUBSEP sess] = 1; nsess[key]++ }
        }
      }
    }
    END {
      for (k in rows) {
        if (nbase[k] < 2 || nsess[k] < 2) continue
        i = index(k, "|")
        printf "  %s   slot %s\n%s", substr(k, 1, i - 1), substr(k, i + 1), rows[k]
      }
    }
  ' "$tmp")

  if [ -n "$slots" ]; then
    echo "Same numbered slot, different filenames — git merges these CLEANLY and they are"
    echo "still wrong. The sequence is a shared namespace git does not model:"
    echo ""
    printf '%s\n' "$slots"
    echo ""
  fi

  if [ "$degraded" -eq 1 ]; then
    warn "git $(git --version | awk '{print $3}') has no 'merge-tree --write-tree' (needs 2.38)"
    warn "— only the overlap heuristic above ran; real conflicts were NOT decided"
  fi

  if [ "$real" -eq 0 ] && [ -z "$overlaps" ] && [ -z "$slots" ]; then
    echo "No file is being edited in more than one session."
    return 0
  fi
  if [ "$real" -eq 0 ] && [ -n "$slots" ]; then
    echo "Nothing would conflict TEXTUALLY at merge — but a clean merge is not the same"
    echo "question as a correct result, and the slot clash above is the difference."
  elif [ "$real" -eq 0 ]; then
    echo "Nothing would conflict at merge as things stand."
  else
    echo "Overlap is normal; a real conflict is a decision waiting to happen. Both resolve"
    echo "at merge, with a diff — knowing now is what lets you split the work instead."
  fi
  return 0
}

# ---------------------------------------------------------------------------
DOCTOR_PROBLEMS=0
dr_bad()  { echo "  ✗ $*"; DOCTOR_PROBLEMS=$((DOCTOR_PROBLEMS + 1)); }
dr_ok()   { echo "  ✓ $*"; }
dr_note() { echo "  · $*"; }

cmd_doctor() {
  # Everything a multi-repo tool can silently get wrong, asked out loud. Reports
  # by default; --fix only performs the two repairs that cannot lose work.
  local fix=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --fix) fix=1 ;;
      -*)    err "unknown flag: $1 (usage: pleach doctor [--fix])" ;;
      *)     err "unexpected argument: $1 (usage: pleach doctor [--fix])" ;;
    esac
    shift
  done
  load_config

  local s
  echo "workspace"
  # A canonical that is itself a session is always a misresolution, whatever led to
  # it — a stale PLEACH_CANONICAL, a copied folder, a resolution order that changed.
  # Saying so beats certifying it: doctor used to print "no problems found" over a
  # workspace whose canonical was one of its own sessions.
  if [ -f "$CANONICAL/.session-env" ]; then
    dr_bad "the resolved canonical is itself a session ($CANONICAL) — every path below is derived from it, so nothing here can be trusted. Run from the canonical, or set PLEACH_CANONICAL to it"
  else
    dr_ok "canonical: $CANONICAL"
  fi
  if [ -f "$CANONICAL/$CONF_NAME" ]; then
    dr_ok "$CONF_NAME present"
  else
    dr_note "no $CONF_NAME — auto-detection in use (write one with: pleach init)"
  fi

  local -a detected=() drift=()
  while IFS= read -r s; do [ -n "$s" ] && detected+=("$s"); done < <(detect_subs)
  for s in ${SUBS[@]+"${SUBS[@]}"}; do
    [ -e "$CANONICAL/$s/.git" ] || drift+=("$s")
  done
  if [ ${#drift[@]} -gt 0 ]; then
    dr_bad "declared in PLEACH_SUBS but missing from disk: ${drift[*]} (align with: pleach repos --sync)"
  else
    dr_ok "${#detected[@]} sub-repo(s) on disk, all resolvable"
  fi

  # -e, not -f or -d: the lock is a file now and was a directory before, and being
  # blind to either shape means reporting "no lock held" over a held lock.
  if [ -e "$SESSIONS/.pleach.lock" ]; then
    # A lock whose owner is ALIVE on this machine is not dirt — it is ordinary
    # concurrency, and tearing it down would lose work. --fix only removes what
    # can be shown to be abandoned.
    local lock_pid="" lock_host="" this_host
    this_host=$(uname -n 2>/dev/null || echo '?')
    if [ -f "$SESSIONS/.pleach.lock" ]; then
      # The lock IS the owner line, hard-linked into place complete.
      read -r lock_pid lock_host < "$SESSIONS/.pleach.lock" 2>/dev/null || true
    elif [ -f "$SESSIONS/.pleach.lock/owner" ]; then
      read -r lock_pid lock_host < "$SESSIONS/.pleach.lock/owner" 2>/dev/null || true
    fi
    # A pid is a number or it is not a pid: `kill -0` on anything else is an error
    # about the wrong thing. Treat unparseable as unknown.
    case "$lock_pid" in ''|*[!0-9]*) lock_pid="" ;; esac
    if [ -z "$lock_pid" ]; then
      # No owner recorded. Since the lock became a file that carries its owner from
      # the instant it exists, this can only be a directory lock from an older
      # version — possibly held by a run of that version which is very much alive.
      # We cannot tell, and guessing wrong tears down a live run, so unknown is
      # never removed automatically.
      dr_bad "lock held at $SESSIONS/.pleach.lock with no owner recorded — it may belong to a live run of an older version; --fix will not touch it. If you are sure nothing is running: rm -rf '$SESSIONS/.pleach.lock'"
    elif [ "$lock_host" = "$this_host" ] && kill -0 "$lock_pid" 2>/dev/null; then
      dr_note "lock is LIVE (pid $lock_pid, on this machine) — another run is mid-way; --fix leaves it alone"
    elif [ "$fix" -eq 1 ]; then
      if [ -d "$SESSIONS/.pleach.lock" ]; then
        rm -f "$SESSIONS/.pleach.lock/owner" 2>/dev/null || true
        rmdir "$SESSIONS/.pleach.lock" 2>/dev/null || true
      else
        rm -f "$SESSIONS/.pleach.lock" 2>/dev/null || true
      fi
      if [ -L "$SESSIONS/.pleach.lock" ] || [ -e "$SESSIONS/.pleach.lock" ]; then
        dr_bad "lock at $SESSIONS/.pleach.lock could not be released — remove it by hand"
      else
        dr_ok "stale lock released (its owner was pid $lock_pid, which no longer exists)"
      fi
    else
      dr_bad "lock held at $SESSIONS/.pleach.lock (pid $lock_pid, no longer running) — release with: pleach doctor --fix"
    fi
  else
    dr_ok "no lock held"
  fi

  # Worktrees git still believes in, whose folder is gone. They make the next
  # `new` fail with a confusing "already used by worktree" and are invisible
  # from the session side, because the session is precisely what vanished.
  local repo label wt norm
  # REPAIR FIRST, before anything is inspected or pruned. A moved canonical leaves
  # every worktree's back-link broken while the FOLDERS ALL STILL EXIST — so nothing
  # is "registered but gone", and a repair hung off the stale-registration branch
  # never runs at all. Every check below is more accurate on a repaired tree, and
  # repair is idempotent and cannot lose work, which is what earns it a place here.
  #
  # Bare `repair` covers the canonical having moved: the recorded gitdir still points
  # at the worktrees, so git can find and re-link them. It cannot cover a worktree
  # that itself moved, because there the recorded path is the stale half — for those
  # the current locations have to be handed over, which is what is on disk.
  if [ "$fix" -eq 1 ]; then
    local -a here=()
    while IFS= read -r wt; do [ -n "$wt" ] && here+=("$wt"); done < <(
      find "$SESSIONS" -mindepth 1 -maxdepth 2 -name .git 2>/dev/null | sed 's|/\.git$||'
    )
    for s in "" ${detected[@]+"${detected[@]}"}; do
      repo=$(repo_path "$s")
      git -C "$repo" worktree repair 2>/dev/null || true
      [ ${#here[@]} -gt 0 ] && git -C "$repo" worktree repair "${here[@]}" 2>/dev/null || true
    done
  fi

  echo ""
  echo "worktree registrations"
  local -a stale=()
  for s in "" ${detected[@]+"${detected[@]}"}; do
    repo=$(repo_path "$s"); label="${s:-root}"
    while IFS= read -r wt; do
      [ -n "$wt" ] || continue
      norm=$(normalize_path "$wt")
      case "$norm" in "$(normalize_path "$SESSIONS")"/*) ;; *) continue ;; esac
      [ -d "$norm" ] && continue
      stale+=("$label: $norm")
    done < <(git -C "$repo" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p')
  done
  if [ ${#stale[@]} -eq 0 ]; then
    dr_ok "no stale worktree registrations"
  elif [ "$fix" -eq 1 ]; then
    # Repair already ran above, so whatever is still stale here genuinely has no
    # folder to point at and pruning it cannot lose anything.
    for s in "" ${detected[@]+"${detected[@]}"}; do
      git -C "$(repo_path "$s")" worktree prune 2>/dev/null || true
    done
    dr_ok "pruned ${#stale[@]} stale registration(s) that repair could not restore"
  else
    for wt in "${stale[@]}"; do dr_bad "registered but gone — $wt"; done
    dr_note "clear them with: pleach doctor --fix"
  fi

  echo ""
  echo "sessions ($SESSIONS)"
  local n dir idx port cur branch listeners found=0 seen_idx="" seen_port=""
  local -a present=() missing=()
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    found=1
    dir="$SESSIONS/$n"
    branch=$(session_branch "$n")
    # A creation that never finished. Once .session-env is written a half-built
    # session carries every artefact a finished one does, so without this marker
    # doctor certified it and `ls -l` offered it up as removable.
    if session_incomplete "$n"; then
      dr_bad "$n: creation never finished — it may be missing repos or dependencies. Finish it with: pleach add $n --all && pleach clean $n --bootstrap  (or drop it: pleach rm $n --force)"
    fi
    if [ ! -f "$dir/.session-env" ]; then
      # The old advice named two things that do not work: `new` refuses a name whose
      # folder exists, and copying another session's file would hand this one that
      # session's index and port block — the collision the design exists to prevent.
      # A free index and a fresh file is a repair, so --fix does it.
      if [ "$fix" -eq 1 ]; then
        # Under the same lock `new` takes, and for the same reason: free_index reads
        # the .session-env files, so choosing and recording have to be one critical
        # section or a concurrent creation hands out this index too.
        local lost_idx
        lock
        lost_idx=$(free_index)
        write_session_env "$dir" "$n" "$lost_idx" "$((PORT_START + lost_idx * 100))"
        unlock
        dr_ok "$n: .session-env restored (index $lost_idx, ports $((PORT_START + lost_idx * 100))+)"
      else
        dr_bad "$n: no .session-env — ports and identity unknown; restore it with: pleach doctor --fix"
        continue
      fi
    fi
    if session_env_unreadable "$dir"; then
      # Reported before the index/port checks below, because those read the very
      # values that are missing: they used to print "index , ports +" behind a
      # tick, and a reader scanning ticks saw a healthy session.
      dr_bad "$n: .session-env has no PLEACH_INDEX — the port block it holds cannot be named, so no new session can be given one that is certainly free; convert it or remove it: rm '$dir/.session-env'"
      continue
    fi
    # A renamed folder makes every name-keyed check look at the wrong branch, so it
    # is a problem in its own right rather than a detail of the ones below.
    local id_problem
    if id_problem=$(session_identity_problem "$n"); then
      dr_bad "$n: $id_problem"
      continue
    fi
    idx=$(session_env_get "$dir" PLEACH_INDEX)
    port=$(session_env_get "$dir" PLEACH_PORT_BASE)
    # shellcheck disable=SC2086  # deliberate split: these are space-separated lists
    if in_list "$idx" $seen_idx; then
      dr_bad "$n: index $idx is already taken by another session — their port blocks overlap"
    else
      seen_idx="$seen_idx $idx"
    fi
    # shellcheck disable=SC2086
    if in_list "$port" $seen_port; then
      dr_bad "$n: port block $port is already taken by another session"
    else
      seen_port="$seen_port $port"
    fi
    grep -q '^export PLEACH_SLUG=' "$dir/.session-env" \
      || dr_note "$n: .session-env predates the runtime identity (added on the next: pleach open $n)"
    [ -f "$dir.code-workspace" ] || dr_note "$n: no .code-workspace (regenerated by: pleach open $n code)"

    present=(); missing=()
    while IFS= read -r s; do [ -n "$s" ] && present+=("$s"); done < <(session_subs "$dir")
    for s in ${SUBS[@]+"${SUBS[@]}"}; do
      in_list "$s" ${present[@]+"${present[@]}"} || missing+=("$s")
    done
    [ ${#missing[@]} -gt 0 ] && dr_note "$n: missing sub-repo(s) ${missing[*]} (mount with: pleach add $n --all)"

    for s in "" ${present[@]+"${present[@]}"}; do
      wt="$dir${s:+/$s}"
      [ -e "$wt/.git" ] || continue
      cur=$(git -C "$wt" branch --show-current 2>/dev/null || echo "")
      # A broken back-link and a detached HEAD both leave `branch --show-current`
      # empty. Reporting the first as the second is how a workspace with every repo
      # answering "fatal: not a git repository" got certified healthy — the one
      # command whose job is to catch quiet breakage, going quiet.
      if ! git -C "$wt" rev-parse --git-dir >/dev/null 2>&1; then
        dr_bad "$n: ${s:-root} is not a usable git worktree — the canonical has probably moved. Repair with: git -C '$(repo_path "$s")' worktree repair '$wt'"
      else
        [ "$cur" = "$branch" ] || dr_note "$n: ${s:-root} sits on '${cur:-detached HEAD}', not $branch (sync skips it unless --any-branch)"
      fi
    done

    listeners=$(session_listeners "${port:-}")
    if [ -n "$listeners" ]; then
      dr_note "$n: $(printf '%s\n' "$listeners" | wc -l | tr -d ' ') process(es) listening in its block $port-$((port + 99))"
    fi
    # A green summary line directly under "✗ creation never finished" contradicts
    # it, and a reader scanning for ✓/✗ sees whichever comes last. The facts still
    # help, so they stay — as a note, not a verdict.
    if session_incomplete "$n"; then
      dr_note "$n: index $idx, ports $port+, $(( ${#present[@]} + 1 )) repo(s) — but see above"
    else
      dr_ok "$n: index $idx, ports $port+, $(( ${#present[@]} + 1 )) repo(s)"
    fi
  done < <(session_names)
  [ "$found" -eq 0 ] && dr_note "(no sessions)"

  # An installed agent skill is a COPY, so it ages the moment pleach is upgraded —
  # silently, which is the worst way for guidance to be wrong. Reported, never
  # repaired: the file is generated, but it is also editable, and --fix is
  # reserved for repairs that cannot lose work.
  local skill_copy how
  for skill_copy in "$HOME/.claude/skills/pleach/SKILL.md" \
                    "$CANONICAL/.claude/skills/pleach/SKILL.md"; do
    [ -f "$skill_copy" ] || continue
    case "$skill_copy" in "$CANONICAL"/*) how="--project" ;; *) how="--install" ;; esac
    if skill_doc | cmp -s - "$skill_copy"; then
      dr_ok "the agent skill at $skill_copy matches this pleach"
    else
      dr_bad "the agent skill at $skill_copy is from a different pleach — refresh with: pleach skill $how"
    fi
  done

  echo ""
  if [ "$DOCTOR_PROBLEMS" -eq 0 ]; then
    echo "✅ no problems found."
    return 0
  fi
  echo "$DOCTOR_PROBLEMS problem(s) found."
  return 1
}

# ---------------------------------------------------------------------------
skill_doc() {
  # Kept inside this script on purpose, exactly like `completions` and
  # `shell-init`: a single copied `pleach` stays self-sufficient (cmd_install
  # copies nothing else, and npm/brew ship one executable). A skill in a separate
  # file would be a path that is right in the repo and wrong everywhere else.
  cat <<'PLEACH_SKILL_EOF'
---
name: pleach
description: Use when a workspace has a .pleach.conf at its root or a .session-env in the tree, when several tasks, branches or agents have to run in parallel over one or more git repos without colliding, or when a request involves creating, syncing, inspecting or removing parallel worktree sessions.
---

# pleach

Parallel work sessions for a multi-repo workspace: one git worktree per repo on
branch `session/<name>`, plus the state git cannot isolate — an exclusive block of
100 ports and a runtime identity (database name, compose project name).

Every flag lives in the tool — `pleach help`, `pleach help <command>`, `pleach help config`.
Read those rather than guess. This skill carries the judgment they do not.

## Two roles, one boundary

A `.session-env` at or above the working directory means you are INSIDE a session.
A `.pleach.conf` and no `.session-env` means you are in the canonical checkout.

|                                | Canonical (outside)                     | Inside a session                                                        |
| ------------------------------ | --------------------------------------- | ----------------------------------------------------------------------- |
| Purpose                        | integration, releases, session lifecycle | implementing one task                                                    |
| Remove / prune sessions        | yes                                     | target other sessions. Your own is the hazard, and the tool is not a safety net for it: `pleach rm` refuses it only while it still holds pending work, and `pleach prune --apply` sweeps every integrated session — including the one you stand in |
| Deploy, publish, `terraform apply` | yes                                  | **no** — two sessions collide in the *environment*; git isolates files, not environments |
| Edit code                      | prefer a session                        | yes, that is the job                                                     |

When a request from inside a session needs the other side, name the command and
where it must run. Do not run it.

## The blind spot isolation buys

Worktrees move collisions to merge time — and hide them until then. Work in another
session is invisible to yours by construction.

- `pleach conflicts` — git's own three-way merge between every pair of session
  branches, in memory, plus a check for two sessions claiming the same numbered
  slot (`0004_billing.sql` against `0004_last_login.sql`: different files, so git
  merges them clean and lands two migrations numbered 0004). Always exits 0.
  **A green result is still not compatibility.** It answers "would this merge
  conflict?" and "is a numbered slot claimed twice?" — never "is the combined
  result correct?". Duplicate route paths, two features taking one feature-flag
  name, the same port hardcoded twice: all merge clean and none of them show up
  here. A green answer from a check whose scope does not cover your question is
  not evidence.
- `pleach each '<command>'` — runs it in the canonical and in every session ROOT.
  Add `--repos` to descend into every mounted sub-repo as well; without it, a
  composite workspace answers for the root worktree only. Use it before claiming any
  workspace-wide identifier: a migration number, an RFC number, a port, a
  feature-flag name. What your worktree lists is not evidence it is free.

## What the tool already says — read it there

`pleach help <command>` carries these in full, and cannot drift from the code the way a
copy here would. Go to it rather than assume:

- `pleach prune` and `pleach clean` only **list** until `--apply`; `pleach sync --all`
  refuses without a TTY unless you pass `--yes`; `pleach rm` refuses while work is pending.
- "Integrated" is judged against the **local** base, and `pleach sync` never reaches for
  origin — a PR merged on the remote is invisible until `git fetch`.
- `pleach ls --json` is the machine surface; the human table is not a contract. There is no
  MCP server, and the shell-out is the interface deliberately.
- `.session-env` holds `PORT`, one `PLEACH_PORT_<SUB>` per mounted repo (they all read
  `$PORT`, so point each service at its own), and the runtime identity (`PLEACH_DB_NAME`,
  `COMPOSE_PROJECT_NAME`) — the state git does not isolate. `pleach open` sources it for
  the command it launches; a shell you opened yourself has not.

Everything else — the command list, every flag, `.pleach.conf` — is one `pleach help`
away, and the baseline agents this skill was tested against all reached for it first.

## Red flags — stop

- Removing the session you stand in — directly with `pleach rm`, or by letting
  `pleach prune --apply` sweep it once its work has landed.
- Treating a green `pleach conflicts` as proof that parallel work is compatible.
- Running a deploy, a publish or `terraform apply` from inside a session.
- Choosing a migration, RFC or port number from what a single worktree can see.
- Reporting a `pleach prune` or `pleach clean` listing as work performed.
- Starting a dev server, a migration or a container without `source .session-env`.

## Rationalizations

| Thought                                                  | Reality                                                                 |
| -------------------------------------------------------- | ----------------------------------------------------------------------- |
| "They asked me to tidy up, so I will remove this session." | Other sessions are fine. Removing the one you occupy pulls the ground from under you — name it, let it run outside. |
| "`conflicts` was green, so the sessions are compatible."  | It ruled out a textual merge conflict and a twice-claimed numbered slot. Two files can still collide in meaning without either. |
| "It is a one-line deploy and the code is identical."      | The environment is shared. That is the collision git cannot see.        |
| "Nothing else touches this file."                         | You cannot see the other sessions. `pleach conflicts` can — for files.  |
| "The next number is whatever my worktree does not have."  | Your worktree answers what *you* have, never what is taken. `pleach each`. |
PLEACH_SKILL_EOF
}

POINTER_BEGIN='<!-- pleach:begin -->'
POINTER_END='<!-- pleach:end -->'

pointer_block() { # the few lines an agent needs before it does anything else
  cat <<EOF
$POINTER_BEGIN
## Parallel sessions (pleach)

Work in this workspace happens in **sessions**: one git worktree per repo on branch
\`session/<name>\`, each with an exclusive block of 100 ports and its own runtime
identity (database name, compose project name) — the state git does not isolate.

- A \`.session-env\` at or above the working directory means you are INSIDE a session.
  A \`.pleach.conf\` and no \`.session-env\` means the canonical checkout.
- Deploys, publishes and anything else touching shared state run from the canonical
  only. Two sessions collide in the environment, and git cannot merge that.
- Before claiming a workspace-wide identifier — a migration number, a port, a feature
  flag — check every session with \`pleach each --repos '<command>'\`. What your own
  worktree lists is not evidence the name is free.
- Commands and flags: \`pleach help\`, \`pleach help <command>\`, \`pleach help config\`.

Generated by \`pleach skill --project\`; edit outside the markers.
$POINTER_END
EOF
}

write_pointer() { # $1 = an instruction file that ALREADY exists
  # Only ever a file the project already has: whether a workspace should have an
  # AGENTS.md or a CLAUDE.md is the team's decision, not a side effect of adopting
  # a tool. Everything outside the markers is copied through untouched, and a
  # previous block is replaced rather than appended to, so re-running after an
  # upgrade refreshes the pointer instead of stacking copies of it.
  [ -f "$1" ] || return 1
  local tmp
  # Counting the markers is not enough: one of each, closing first, counts equal and
  # is still malformed — the rewrite below would then swallow from the opening marker
  # to the end of the file, taking the team's text with it. Order and nesting are what
  # matter, so they are what is checked.
  if ! awk -v b="$POINTER_BEGIN" -v e="$POINTER_END" '
    $0 == b { if (inside) bad = 1; inside = 1; next }
    $0 == e { if (!inside) bad = 1; inside = 0; next }
    END     { exit (bad || inside) }
  ' "$1"; then
    warn "$1 has malformed pleach markers (out of order, nested or unclosed) — leaving it alone; pair them by hand"
    return 1
  fi
  tmp=$(mktemp) || return 1
  # Second pass drops the blank lines left dangling at the end by the removal;
  # without it the file grows by one blank line on every run.
  awk -v b="$POINTER_BEGIN" -v e="$POINTER_END" '
    $0 == b { skip = 1; next }
    $0 == e { skip = 0; next }
    !skip   { print }
  ' "$1" \
    | awk '/^[[:space:]]*$/ { blanks++; next } { while (blanks > 0) { print ""; blanks-- } print }' \
    > "$tmp" || { rm -f "$tmp"; return 1; }
  { printf '\n'; pointer_block; } >> "$tmp" || { rm -f "$tmp"; return 1; }
  mv "$tmp" "$1" || { rm -f "$tmp"; return 1; }
  return 0
}

cmd_skill() {
  local dest="" chosen="" flag project=0
  while [ $# -gt 0 ]; do
    flag="$1"
    case "$1" in
      --install)  dest="$HOME/.claude/skills/pleach" ;;
      --project)  dest="$PWD/.claude/skills/pleach"; project=1 ;;
      --dir)      shift
                  [ $# -gt 0 ] && [ -n "$1" ] || err "--dir needs a path"
                  # A following flag is a typo, not a directory: without this,
                  # `--dir --install` reaches mkdir and fails in mkdir's words.
                  case "$1" in -*) err "--dir needs a path, got the flag $1 (for a path starting with '-', use --dir=$1)" ;; esac
                  flag="--dir"; dest="$1/pleach" ;;
      --dir=*)    [ -n "${1#--dir=}" ] || err "--dir needs a path"
                  flag="--dir"; dest="${1#--dir=}/pleach" ;;
      -*)         err "unknown flag: $1 (usage: pleach skill [--install|--project|--dir <path>])" ;;
      *)          err "unexpected argument: $1 (usage: pleach skill [--install|--project|--dir <path>])" ;;
    esac
    # One destination only — silently honouring the last flag would be a trap.
    [ -z "$chosen" ] || err "pick a single destination, not both $chosen and $flag"
    chosen="$flag"
    shift
  done
  # No config is loaded on purpose: the skill must be installable before pleach
  # has been adopted anywhere, and from any directory.
  if [ -z "$dest" ]; then skill_doc; return 0; fi
  mkdir -p "$dest" || err "cannot create $dest"
  skill_doc > "$dest/SKILL.md"
  info "skill written to $dest/SKILL.md"
  info "it is a copy, not a link — re-run this after upgrading pleach"
  # The skill file only reaches harnesses that read .claude/skills. The ones that
  # read AGENTS.md or CLAUDE.md see neither it nor the conf, so without a pointer
  # nothing tells them the workspace has sessions at all.
  if [ "$project" -eq 1 ]; then
    local f touched=""
    for f in AGENTS.md CLAUDE.md; do
      [ -f "$PWD/$f" ] || continue
      write_pointer "$PWD/$f" && touched="$touched $f"
    done
    if [ -n "$touched" ]; then
      info "pointer block updated in:$touched"
    else
      info "no AGENTS.md or CLAUDE.md here — agents that read those will not learn about pleach from them"
    fi
  fi
}

# ---------------------------------------------------------------------------
cmd_install() {
  local target_dir="$HOME/.local/bin" target src
  mkdir -p "$target_dir"
  # Both sides are resolved to a PHYSICAL path before being compared. Comparing
  # the raw strings let any non-normalised HOME — a trailing slash, a doubled
  # slash — walk straight past this guard, and cp then refused in its own words
  # instead of pleach's. Plain `pwd` is not enough either: it is logical, so a
  # symlinked home resolves on one side of the comparison and not the other.
  target=$(cd "$target_dir" && pwd -P)/pleach
  src=$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")
  [ "$src" = "$target" ] && err "you are running the installed copy — run install from the source checkout (the pleach repo)"
  cp "$src" "$target"
  chmod +x "$target"
  info "installed at $target"
  # shellcheck disable=SC2088  # literal ~ is deliberate: this is message text, not a path
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) warn "~/.local/bin is not on your PATH — add to ~/.zshrc: export PATH=\"\$HOME/.local/bin:\$PATH\"" ;;
  esac
}

# ---------------------------------------------------------------------------
cmd_update() {
  # Installs managed by npm/bun update through the package manager.
  local self="$0"
  [ -L "$self" ] && self=$(readlink "$self")
  case "$self" in
    *node_modules*|*/.bun/*)
      err "this install is managed by npm/bun — update with: bun update -g @diogoaguedes/pleach (or npm update -g @diogoaguedes/pleach)"
      ;;
    */Cellar/*|*/homebrew/*|*/linuxbrew/*)
      err "this install is managed by Homebrew — update with: brew update && brew upgrade pleach"
      ;;
  esac
  command -v curl >/dev/null 2>&1 \
    || err "update needs curl — alternative: clone https://github.com/$PLEACH_REPO and run ./pleach install"
  local target tmp newver
  target="$HOME/.local/bin/pleach"
  tmp=$(mktemp)
  curl -fsSL "https://raw.githubusercontent.com/$PLEACH_REPO/main/pleach" -o "$tmp" \
    || { rm -f "$tmp"; err "download failed (offline, or $PLEACH_REPO unreachable?)"; }
  bash -n "$tmp" 2>/dev/null \
    || { rm -f "$tmp"; err "the downloaded script fails its syntax check — aborted (nothing was changed)"; }
  if [ -f "$target" ] && cmp -s "$tmp" "$target"; then
    rm -f "$tmp"
    info "already on the latest version ($target)"
    return 0
  fi
  chmod +x "$tmp"
  mkdir -p "$(dirname "$target")"
  mv "$tmp" "$target"
  newver=$("$target" version 2>/dev/null || echo "pleach ?")
  info "updated $target ($newver)"
}

